---
import datos from '../datos/dataset.json';
import Jsonld from '../componentes/Jsonld.astro';
import Buscador from '../componentes/Buscador.jsx';
import { SITIO, abs } from '../sitio.js';
import { EVIDENCIA } from '../datos/evidencia.js';
import { porFamilia } from '../datos/familias.js';
import { categoriasEn } from '../datos/categorias-i18n.js';
import { OBJETIVOS } from '../datos/eficacia.js';
import { ARCHIVO, DISPLAY } from '../estilos/fuentes.js';
import {
  IDIOMAS, LANG, NOMBRE_IDIOMA, OG_LOCALE, POR_DEFECTO,
  fechaLargaEn, ruta, sinPrefijo, textos, txtBuscador,
} from '../i18n.js';
import '../estilos/fuentes.css';
import '../estilos/global.css';

// `schema` son los nodos JSON-LD propios de cada pagina (Product, ItemList, migas...).
// El WebSite y el editor los pone este layout: van en todas las paginas o no van.
//
// `lang` es la pieza nueva y hace dos trabajos a la vez: dice en que idioma se pinta la
// pagina Y dice que esta pagina EXISTE en los tres idiomas. Las que no se traducen (las
// 2.900 fichas de producto, entrar, registro, el panel) no lo pasan, y asi el layout sabe
// que no debe escribirles hreflang ni ofrecerles el selector: un alternate que apunta a
// un 404 hace mas dano que no tener alternate.
const { titulo, descripcion, ancho, schema = [], noindex = false, lang } = Astro.props;
const idioma = lang ?? POR_DEFECTO;
const traducida = lang !== undefined;
const t = textos(idioma);

// Ruta normalizada sin barra final: sirve para marcar el enlace activo del menu. Se
// compara SIEMPRE en su forma espanola, que es como se escriben los `href` de aqui abajo.
const aqui = sinPrefijo(Astro.url.pathname).replace(/\/$/, '') || '/';
// Un enlace interno: se escribe el camino en espanol y sale con el prefijo que toque.
const r = (camino) => ruta(idioma, camino);
const canonica = abs(Astro.url.pathname);
// Las tres versiones de ESTA pagina, solo si la pagina esta traducida.
const alternativas = traducida
  ? Object.fromEntries(IDIOMAS.map((l) => [l, abs(ruta(l, sinPrefijo(Astro.url.pathname)))]))
  : null;

const fechaLarga = (iso) => fechaLargaEn(idioma, iso);
// El estante lo bautiza familias.js en espanol, que es decision editorial y no un dato:
// aqui se traduce por su nombre. Un estante nuevo sin texto cae al espanol, no a un hueco.
const estante = (nombre) => t(`familia.${nombre}`);
// Los textos del buscador, ya traducidos: es una isla de React y no puede leer el
// diccionario sin arrastrarlo entero al navegador (ver i18n.js).
const txtBusca = txtBuscador(idioma);

const grafo = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': abs('/#sitio'),
      url: SITIO.url,
      name: SITIO.nombre,
      description: t('sitio.descripcion'),
      inLanguage: LANG[idioma],
      publisher: { '@id': abs('/#editor') },
    },
    {
      // Quien firma los datos. Una comparativa de precios sin autor identificable no
      // la cita ni Google ni un modelo: es la mitad del E-E-A-T y cuesta doce lineas.
      '@type': 'Organization',
      '@id': abs('/#editor'),
      name: SITIO.nombre,
      url: SITIO.url,
      slogan: t('sitio.lema'),
      description: t('sitio.descripcion'),
      areaServed: SITIO.pais,
      publishingPrinciples: abs('/metodologia'),
      founder: { '@id': abs('/#autor') },
      foundingDate: '2026',
      knowsAbout: ['Suplementacion deportiva', 'Precio por kilo de suplementos',
                   'Certificacion de suplementos', 'Creapure', 'IFOS'],
    },
    {
      // La persona detras. Google trata la suplementacion como YMYL y no sube al top una
      // web de salud sin autor identificable. Lo que se afirma aqui es lo unico que se
      // puede afirmar sin mentir, y /quienes-somos lo desarrolla, incluido lo que NO es.
      '@type': 'Person',
      '@id': abs('/#autor'),
      name: SITIO.autor.nombre,
      jobTitle: t('sitio.autor.rol'),
      description: `${t('sitio.autor.hace')} ${t('sitio.autor.no_hace')}`,
      email: `mailto:${SITIO.contacto}`,
      url: abs('/quienes-somos'),
      worksFor: { '@id': abs('/#editor') },
    },
    ...schema,
  ],
};
const total = datos.productos.length;
// Cuantos dias tienen los precios que se estan ensenando. Si el robot diario se para,
// la web sigue publicando la edicion de hace tres semanas con la misma cara de siempre:
// esto lo dice en voz alta. Diez dias es el umbral porque el robot corre a diario y una
// semana de margen cubre un fallo puntual sin dar la alarma por nada.
const diasDelDato = datos.generado
  ? Math.floor((Date.now() - Date.parse(datos.generado)) / 86400000) : null;
const datoViejo = diasDelDato != null && diasDelDato > 10;
// Con treinta categorias no cabe una fila de enlaces: van dentro de un <details>,
// y ahi tampoco se leen en plano: por estante, igual que las guias.
const enCategoria = datos.categorias.some((c) => aqui === `/${c.slug}`);
// Los nombres de categoria son la navegacion principal de la web y NO salen del dataset
// tal cual: el dataset los escribe en espanol (categorias.py) y aqui se traducen. Ver
// datos/categorias-i18n.js. El slug, que es lo que va en la URL, no cambia nunca.
const cats = categoriasEn(datos.categorias, idioma);
const categorias = porFamilia(cats, () => true, idioma);
// Las guias son treinta y tambien: van agrupadas por estante para que el menu se lea.
const guias = porFamilia(cats, (c) => EVIDENCIA[c.slug], idioma);
const enGuia = aqui === '/guias' || aqui.startsWith('/guia/');
// El tercer menu: los articulos que se leen antes de elegir categoria (que funciona, para
// que objetivo, en que tienda). Sin el estaban publicados y no se llegaba a ellos.
const enFunciona = aqui === '/suplementos-que-funcionan' || aqui.startsWith('/para/')
  || aqui === '/tiendas' || aqui.startsWith('/tiendas/');
---
<!doctype html>
<html lang={LANG[idioma]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    document.documentElement.dataset.tema =
      localStorage.getItem('tema') ||
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'oscuro' : 'claro');
  </script>
  {/* Autodeteccion de idioma. Va aqui arriba, antes de que se pinte nada, y solo en las
      paginas que existen en los tres idiomas: `alternativas` trae las que hay, asi que
      desde una ficha de producto (que solo esta en espanol) esto ni se escribe.

      Tres cuidados que son la diferencia entre esto y un bucle de redirecciones:
        1. Si el visitante ya eligio idioma a mano, manda su eleccion y el navegador no
           se vuelve a mirar. Es justo lo que pide quien cambia de idioma a proposito.
        2. Solo se redirige UNA vez por sesion. Sin esto, el boton "atras" devuelve a la
           version espanola, el script la ve y la manda otra vez a /en/: la pagina se
           queda atrapada y no hay manera de salir hacia atras.
        3. `location.replace` y no `location.href`: la version que el visitante no queria
           no deja entrada en el historial.
      Y a los robots no se les redirige nunca: Googlebot renderiza en en-US y sin
      storage, asi que cada pagina espanola le parecia una redireccion a /en/ y la sacaba
      del indice. Ellos descubren las versiones por el hreflang.
      El idioma del navegador se lee por su raiz ("en-GB" -> "en"). Lo que no este entre
      los tres se queda en espanol, que es el idioma del mercado que se compara. */}
  {alternativas && (
    <script is:inline set:html={`(()=>{try{
if(/bot|crawl|spider|slurp|lighthouse|inspect/i.test(navigator.userAgent))return;
var A=${JSON.stringify(alternativas)},D=${JSON.stringify(idioma)};
var g=localStorage.getItem('idioma');
if(!g){
  if(sessionStorage.getItem('idiomaAuto'))return;
  sessionStorage.setItem('idiomaAuto','1');
  g=((navigator.languages&&navigator.languages[0])||navigator.language||'es').slice(0,2).toLowerCase();
}
if(g===D||!A[g])return;
location.replace(A[g]+location.search+location.hash);
}catch(e){}})();`} />
  )}
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  {/* hreflang: le dice a Google que estas tres URLs son la misma pagina en tres idiomas y
      no tres paginas que se copian entre si. `x-default` apunta al espanol, que es donde
      cae quien busca en un idioma que no esta aqui. Sin esto las tres versiones compiten
      por la misma consulta y pierden las tres. */}
  {alternativas && IDIOMAS.map((l) => (
    <link rel="alternate" hreflang={LANG[l]} href={alternativas[l]} />
  ))}
  {alternativas && <link rel="alternate" hreflang="x-default" href={alternativas[POR_DEFECTO]} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:site_name" content={SITIO.nombre} />
  <meta property="og:locale" content={OG_LOCALE[idioma]} />
  {alternativas && IDIOMAS.filter((l) => l !== idioma).map((l) => (
    <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
  ))}
  <meta property="og:image" content={abs('/og.png')} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${SITIO.nombre}: ${t('sitio.lema')}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Sin esto Google recorta el fragmento a ~160 caracteres y no coge la respuesta corta. -->
  {/* Entrar y registrarse son utilidades, no contenido: se sirven, pero no se indexan. */}
  <meta name="robots" content={noindex
    ? 'noindex, follow'
    : 'index, follow, max-snippet:-1, max-image-preview:large'} />
  <meta name="theme-color" content="#efede6" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {/* Las dos caras que pinta la primera pantalla. Las demas cargan cuando toca. */}
  <link rel="preload" as="font" type="font/woff2" href={DISPLAY} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={ARCHIVO} crossorigin />
  <noscript>
    <style>
      table.recortada tbody tr:nth-child(n+26) { display: table-row; }
      @media (max-width: 46rem) {
        table.recortada tbody tr:nth-child(n+26) { display: grid; }
      }
      .ver-mas { display: none; }
    </style>
  </noscript>
  <Jsonld datos={grafo} />
  {SITIO.analitica && SITIO.analitica !== 'auto' && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${SITIO.analitica}"}`}></script>
  )}
</head>
<body>
  <a class="saltar" href="#contenido">{t('chrome.saltar')}</a>

  {/* Aqui iba el teletipo: los siete recuentos del dataset desfilando encima de la
      cabecera, en las 2.978 paginas. Se quito porque no decia NADA que no estuviera ya
      en la misma pantalla: en la portada, la linea de edicion y la respuesta corta dan
      los siete; en una categoria los da el bloque de cifras; y en todas, el colofon del
      pie repite fecha, productos y categorias. Era una segunda copia, en movimiento,
      por encima del titular. Iba `aria-hidden`, asi que no se pierde ni un dato ni un
      enlace: solo 26 px de la primera pantalla y una animacion infinita. */}

  <header class="sitio">
    <div class="envoltorio">
      <button class="hamburguesa" type="button" aria-label={t('chrome.abrir_menu')}
              aria-expanded="false" aria-controls="menu-principal">
        <span aria-hidden="true"></span>
      </button>
      <a class="marca-sitio" href={r('/')}>
        <img class="glifo" src="/favicon.svg" alt="" width="22" height="22" />
        {/* F5.4 / D10: en versales, "FITNESSSUPPLEMENT" junta tres eses y se lee como un
            muro. En caja mixta la segunda palabra empieza por mayuscula y el ojo la separa
            solo; el cambio de peso (700 -> 900 de la condensada) remata el corte sin
            meter un segundo color ni un guion. "wiki" baja a mono y a la MISMA linea
            base, que es de donde flotaba. */}
        <span class="marca-nombre">Fitness<b>Supplement</b></span><span class="fina">wiki</span>
      </a>
      {/* La navegacion real de una web de 50 categorias y 4.300 productos es escribir,
          no bajar por un menu. Hasta ahora el campo solo estaba en la portada: desde
          cualquier otra pagina habia que volver a ella para buscar algo.
          En la portada NO se pinta: alli ya hay uno grande, y dos campos con el mismo
          atajo de teclado ("/") se pelean por el foco. */}
      {aqui !== '/' && (
        <div class="buscador-cabecera">
          <Buscador client:idle categorias={cats} total={total}
                    lang={idioma} txt={txtBusca} etiqueta={t('chrome.buscar')} />
        </div>
      )}
      <nav class="principal" id="menu-principal" aria-label={t('chrome.secciones')}>
        {/* Solo se ve en movil, dentro del panel: sin un titulo arriba, el panel
            empieza directamente en "Categorias" y no se sabe que es lo que se ha
            abierto. Al entrar en un submenu lo sustituye la fila de vuelta. */}
        <p class="cabeza-panel" aria-hidden="true">{t('chrome.menu')}</p>
        {/* Por debajo de 62rem el buscador de la cabecera no cabe: vive aqui. */}
        <div class="buscador-panel">
          <Buscador client:idle categorias={cats} total={total}
                    lang={idioma} txt={txtBusca} etiqueta={t('chrome.buscar')} lista="resultados-panel" />
        </div>
        <details class="menu-cat" name="menu">
          <summary aria-current={enCategoria ? 'page' : undefined}>{t('chrome.categorias')}</summary>
          <div class="lamina laminas-grupos">
            {categorias.map((g) => (
              <div class="grupo-menu">
                <p class="rotulo-menu">{estante(g.nombre)}</p>
                {g.cats.map((c) => (
                  <a href={r(`/${c.slug}/`)} aria-current={aqui === `/${c.slug}` ? 'page' : undefined}>
                    {c.nombre} <span>{c.productos}</span>
                  </a>
                ))}
              </div>
            ))}
            <a class="pie-menu" href={r('/guias/#categorias')}>{t('chrome.ver_categorias')} &rarr;</a>
          </div>
        </details>
        {/* "Que funciona" era una cuarta pestana con tres grupos de tres enlaces, y
            "Guias" otra con cincuenta. Las dos contestan a la misma pregunta ("que me
            leo antes de elegir"), asi que son una sola: los tres grupos de evidencia
            entran ARRIBA de la misma lamina, delante de los estantes de guias. Una
            pestana menos en una barra que ya no cabia en una linea. */}
        <details class="menu-cat" name="menu">
          <summary aria-current={enGuia || enFunciona ? 'page' : undefined}>{t('chrome.guias')}</summary>
          <div class="lamina laminas-grupos">
            <div class="grupo-menu">
              <p class="rotulo-menu">{t('chrome.por_evidencia')}</p>
              <a href={r('/suplementos-que-funcionan/')}
                 aria-current={aqui === '/suplementos-que-funcionan' ? 'page' : undefined}>
                {t('chrome.que_funciona')}
              </a>
            </div>
            <div class="grupo-menu">
              <p class="rotulo-menu">{t('chrome.por_objetivo')}</p>
              {OBJETIVOS.map((o) => (
                <a href={r(`/para/${o.slug}/`)} aria-current={aqui === `/para/${o.slug}` ? 'page' : undefined}>
                  {t(`objetivo.${o.slug}.nombre`)}
                </a>
              ))}
            </div>
            <div class="grupo-menu">
              <p class="rotulo-menu">{t('chrome.por_tienda')}</p>
              <a href={r('/tiendas/')} aria-current={aqui === '/tiendas' ? 'page' : undefined}>
                {t('chrome.tienda_barata')}
              </a>
            </div>
            {guias.map((g) => (
              <div class="grupo-menu">
                <p class="rotulo-menu">{estante(g.nombre)}</p>
                {g.cats.map((c) => (
                  <a href={r(`/guia/${c.slug}/`)} aria-current={aqui === `/guia/${c.slug}` ? 'page' : undefined}>
                    {c.nombre}
                  </a>
                ))}
              </div>
            ))}
            <a class="pie-menu" href={r('/guias/')}>{t('chrome.ver_guias')} &rarr;</a>
          </div>
        </details>
        <a href={r('/metodologia/')} aria-current={aqui === '/metodologia' ? 'page' : undefined}>{t('chrome.metodologia')}</a>
        {/* Estos dos siguen en el menu de las 2.985 paginas, pero en escritorio no gastan
            pestana: "quienes somos" ya esta en el pie y "mi lista" pasa a icono al lado
            del de cuenta, que es donde una tienda pone su carrito. En movil, donde el
            menu es un panel y no una barra, se ven los dos con su nombre escrito. */}
        <a class="solo-panel" href={r('/quienes-somos/')} aria-current={aqui === '/quienes-somos' ? 'page' : undefined}>{t('chrome.quienes_somos')}</a>
        <a class="solo-panel" href={r('/mis-suplementos/')} aria-current={aqui === '/mis-suplementos' ? 'page' : undefined}>{t('chrome.mi_lista')}</a>
        <a class="comparar" href={r('/guias/#categorias')}>{t('chrome.comparar')}</a>

        {/* El pie del panel: lo que no es navegar por el catalogo. En escritorio solo
            se ve el boton de tema, en su sitio de siempre a la derecha de la barra.
            El enlace de administracion sale oculto y lo destapa el script de abajo si
            /api/yo dice que este visitante es admin: la pagina es estatica y va
            cacheada, asi que no puede saberlo al generarse. */}
        <div class="pie-panel">
          <a class="enlace-admin" href="/admin/" title={t('chrome.admin')} hidden>
            <span class="glifo-panel" aria-hidden="true">&#9881;</span><span class="texto-admin">{t('chrome.admin')}</span>
          </a>
          {/* El selector de idioma. Solo sale donde hay a donde ir: ensenarlo en una ficha
              de producto (espanol y nada mas) seria prometer una version que no existe.
              Son tres enlaces de verdad, con su href y su hreflang, asi que funcionan sin
              JavaScript y los sigue un rastreador; el script de abajo solo anota la
              eleccion para que la autodeteccion no la pise en la pagina siguiente. */}
          {alternativas && (
            <details class="idiomas">
              {/* Mini desplegable nativo: el resumen ensena solo el idioma actual y la
                  lista sale al pulsar. Los <a> siguen en el HTML aunque esten cerrados,
                  asi que el rastreador los sigue igual. */}
              <summary aria-label={t('chrome.elegir_idioma')}>
                <span class="glifo-panel" aria-hidden="true">&#127760;</span>{idioma.toUpperCase()}
              </summary>
              <div class="lista-idiomas">
                {IDIOMAS.map((l) => (
                  <a href={alternativas[l]} hreflang={LANG[l]} lang={LANG[l]} data-idioma={l}
                     title={NOMBRE_IDIOMA[l]}
                     aria-current={l === idioma ? 'true' : undefined}>{l.toUpperCase()} <span class="nombre-idioma">{NOMBRE_IDIOMA[l]}</span></a>
                ))}
              </div>
            </details>
          )}
          <button class="tema" type="button" aria-label={t('chrome.tema')}>
            <span class="luna" aria-hidden="true">&#9789;</span><span class="sol" aria-hidden="true">&#9788;</span>
            <span class="texto-tema">{t('chrome.tema_corto')}</span>
          </button>
        </div>
      </nav>
    </div>
    {/* Los iconos van FUERA del envoltorio: el envoltorio esta limitado a 82rem y
        centrado, asi que en una pantalla ancha su borde derecho no es el de la
        ventana. Estos van posicionados contra la cabecera, que si llega a la esquina.
        El href del acceso lleva de vuelta a la pagina desde la que se pulsa. */}
    <a class="mi-lista-cabecera" href={r('/mis-suplementos/')} title={t('chrome.mi_lista')}
       aria-label={t('chrome.mi_lista_larga')}
       aria-current={aqui === '/mis-suplementos' ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
           stroke="currentColor" stroke-width="1.9" stroke-linecap="square">
        <path d="M4 5h16M4 11h16M4 17h9" />
      </svg>
    </a>
    {/* `data-cuenta` lleva el molde de "Tu cuenta: %s" traducido. El script de abajo es
        inline y se escribe una sola vez para los tres idiomas, asi que el texto tiene que
        llegarle desde el HTML: es eso o tres copias del script. */}
    <a class="acceso-cabecera" href="/entrar/" aria-label={t('chrome.entrar_larga')}
       title={t('chrome.entrar')} data-cuenta={t('chrome.tu_cuenta', '%s')}>
      <svg class="silueta" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
        <circle cx="12" cy="8" r="3.6" fill="none" stroke="currentColor" stroke-width="1.9" />
        <path d="M4.6 20.2a7.4 7.4 0 0 1 14.8 0" fill="none" stroke="currentColor"
              stroke-width="1.9" stroke-linecap="square" />
      </svg>
      <span class="inicial" hidden></span>
    </a>
  </header>

  {datoViejo && (
    <p class="aviso-caducado">
      <strong>{t('chrome.caducado.titulo', diasDelDato)}</strong>{' '}
      {t('chrome.caducado.cuerpo', fechaLarga(datos.generado))}
    </p>
  )}

  <main id="contenido">
    <div class={ancho === 'completo' ? 'envoltorio' : 'envoltorio estrecho'}><slot /></div>
  </main>

  <footer class="sitio">
    <div class="envoltorio">
      <div class="rejilla-pie">
        <div>
          <h4>{SITIO.nombre}</h4>
          <p>
            {t('pie.sitio.texto', total)}<strong>{t('pie.sitio.negrita')}</strong>{t('pie.sitio.cola')}
          </p>
        </div>
        <div>
          <h4>{t('chrome.categorias')}</h4>
          <p>{t('pie.categorias.texto', datos.categorias.length)}</p>
          <a class="boton" href={r('/guias/#categorias')}>{t('chrome.ver_categorias')} <span class="flecha">&rarr;</span></a>
        </div>
        <div>
          <h4>{t('chrome.guias')}</h4>
          <p>{t('pie.guias.texto')}</p>
          <a class="boton" href={r('/guias/#guias')}>{t('chrome.ver_guias')} <span class="flecha">&rarr;</span></a>
        </div>
        <div>
          <h4>{t('pie.transparencia')}</h4>
          <ul>
            <li><a href={r('/quienes-somos/')}>{t('chrome.quienes_somos')}</a></li>
            <li><a href={r('/metodologia/')}>{t('chrome.metodologia')}</a></li>
            <li><a href={r('/marcas/')}>{t('pie.marcas')}</a></li>
            <li><a href={r('/metodologia/#niveles')}>{t('pie.niveles')}</a></li>
            <li><a href={r('/metodologia/#formula')}>{t('pie.formula')}</a></li>
            <li><a href={r('/metodologia/#afiliacion')}>{t('pie.afiliacion')}</a></li>
            <li><a href="/llms.txt">{t('pie.llms')}</a></li>
            <li><a href={r('/legal/')}>{t('pie.legal')}</a></li>
            <li><a href={`mailto:${SITIO.contacto}`}>{t('pie.contacto')}</a></li>
          </ul>
        </div>
      </div>
      <div class="colofon">
        <p class="mono">{t('pie.colofon.recogida', fechaLarga(datos.generado), total, datos.categorias.length)}</p>
        <p>
          {t('pie.colofon.autor')} <a href={r('/quienes-somos/')}>{SITIO.autor.nombre}</a>.
          {' '}{t('sitio.autor.no_hace')}
        </p>
        <p>{t('pie.colofon.precios')}</p>
        <p>
          {t('pie.colofon.aviso')}<a href={r('/metodologia/')}>{t('pie.colofon.aviso_enlace')}</a>.
        </p>
      </div>
    </div>
  </footer>

  <!-- Los dos menus son <details>: el atributo name ya impide que se abran los dos a la
       vez, pero nada nativo los cierra al pinchar fuera ni con Escape, y un panel que se
       queda abierto tapando la pagina es lo que hace que un menu parezca roto. -->
  <script is:inline>
    const cabecera = document.querySelector('header.sitio');
    const hamburguesa = document.querySelector('.hamburguesa');
    const cerrarMenu = () => {
      delete cabecera.dataset.menu;
      hamburguesa.setAttribute('aria-expanded', 'false');
      // El panel vuelve a su primera pantalla. Sin esto, quien entro en Categorias y
      // cerro el menu se lo encuentra abierto por dentro la proxima vez que lo abre,
      // y parece que ha perdido las secciones.
      for (const d of cabecera.querySelectorAll('.menu-cat[open]')) d.open = false;
    };
    hamburguesa.addEventListener('click', () => {
      if (cabecera.dataset.menu === undefined) {
        cabecera.dataset.menu = 'abierto';
        hamburguesa.setAttribute('aria-expanded', 'true');
      } else cerrarMenu();
    });
    document.querySelector('.tema').addEventListener('click', () => {
      const raiz = document.documentElement;
      raiz.dataset.tema = raiz.dataset.tema === 'oscuro' ? 'claro' : 'oscuro';
      localStorage.setItem('tema', raiz.dataset.tema);
    });
    // Elegir idioma a mano gana para siempre. El enlace navega solo (es un <a> con su
    // href); lo unico que hace esto es dejar constancia de la eleccion, para que la
    // autodeteccion de la pagina de destino la respete en vez de devolver al visitante
    // al idioma de su navegador. Es la diferencia entre un selector y un boton inutil.
    for (const a of document.querySelectorAll('.idiomas a')) {
      a.addEventListener('click', () => {
        try { localStorage.setItem('idioma', a.dataset.idioma); } catch { /* modo privado */ }
      });
    }
    document.addEventListener('click', (e) => {
      for (const d of document.querySelectorAll('nav.principal details[open]')) {
        if (!d.contains(e.target)) d.open = false;
      }
      const menu = document.querySelector('nav.principal');
      if (!menu.contains(e.target) && !hamburguesa.contains(e.target)) cerrarMenu();
    });
    // El icono de cuenta sale en las 2.994 paginas, que son estaticas y todas iguales:
    // quien esta dentro solo se sabe preguntandolo. Diez lineas sueltas en vez de otra
    // isla de React en cada pagina, que costaria el framework entero para pintar una
    // letra.
    (async () => {
      const icono = document.querySelector('.acceso-cabecera');
      const aqui = location.pathname + location.search;
      if (!/^\/(entrar|registro|recuperar)/.test(location.pathname)) {
        icono.href = '/entrar/?volver=' + encodeURIComponent(aqui);
      }
      try {
        const { usuario, admin } = await (await fetch('/api/yo')).json();
        if (admin) document.querySelector('.enlace-admin').hidden = false;
        if (!usuario) return;
        icono.classList.add('dentro');
        icono.title = usuario.nombre;
        icono.setAttribute('aria-label', icono.dataset.cuenta.replace('%s', usuario.nombre));
        const inicial = icono.querySelector('.inicial');
        inicial.textContent = [...usuario.nombre][0].toUpperCase();
        inicial.hidden = false;
        icono.querySelector('.silueta').remove();
      } catch { /* Sin API (o sin red) el icono se queda como enlace a /entrar. */ }
    })();

    // Cuenta el clic que sale hacia una tienda. Es lo unico que puede convertirse en
    // dinero, y sin medirlo no se sabe en que tienda merece la pena darse de alta.
    //
    // sendBeacon y no fetch: el navegador ya esta abriendo la tienda cuando esto sale, y
    // un fetch normal se cancela al irse la pagina. No espera respuesta y no retrasa el
    // clic ni un milisegundo. Si el navegador no lo trae, no se cuenta y ya: contar un
    // clic no vale entorpecer una compra.
    //
    // Viaja tienda y categoria, y aparte (en /api/evento) el producto desde el que se
    // sale. Son totales por dia sin identificador: por eso esto no es seguimiento y la
    // web sigue sin banner de cookies.
    const evento = (...lista) => navigator.sendBeacon?.('/api/evento',
      new Blob([JSON.stringify(lista)], { type: 'application/json' }));
    const deProducto = (a) => a?.getAttribute('href').match(/\/producto\/([a-z0-9-]+)/)?.[1];
    document.addEventListener('click', (e) => {
      const a = e.target.closest?.('a[data-salida]');
      if (!a || !navigator.sendBeacon) return;
      const producto = location.pathname.match(/\/producto\/([a-z0-9-]+)/)?.[1]
        ?? deProducto(a.closest('tr')?.querySelector('a[href*="/producto/"]'));
      if (producto) evento({ tipo: 'salida-producto', clave: producto });
      const categoria = a.dataset.cat ?? a.closest('[data-cat]')?.dataset.cat;
      if (!categoria) return;
      navigator.sendBeacon('/api/salida', new Blob([JSON.stringify({
        tienda: a.dataset.salida, categoria, afiliado: a.dataset.afiliado === '1',
      })], { type: 'application/json' }));
    });

    // Lo mismo para lo que pasa DENTRO de la web, con el mismo contrato (total por dia,
    // sin identificador). Al cargar: la pagina, el tipo de pantalla y de que web se
    // llega. Al pulsar: la ficha que se abre, el boton (por su texto) y "comparar" /
    // "mi lista" por categoria. /admin no cuenta: serian las visitas del dueno.
    if (!location.pathname.startsWith('/admin')) {
      const slug = (s) => String(s ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '')
        .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);
      const ruta = location.pathname.toLowerCase().replace(/[^a-z0-9./_-]+/g, '-')
        .replace(/^[^a-z0-9]+|\/+$/g, '').slice(0, 120) || 'portada';
      let origen = 'directo';
      try {
        const h = new URL(document.referrer).hostname.replace(/^www\./, '');
        origen = h === location.hostname.replace(/^www\./, '') ? null : h.slice(0, 120);
      } catch { /* sin referrer: se ha entrado escribiendo la direccion o desde un marcador */ }
      evento({ tipo: 'vista', clave: ruta },
        { tipo: 'dispositivo', clave: innerWidth < 768 ? 'movil'
          : matchMedia('(pointer: coarse)').matches ? 'tablet' : 'escritorio' },
        ...(origen ? [{ tipo: 'origen', clave: origen }] : []));

      document.addEventListener('click', (e) => {
        const lista = [];
        const ficha = deProducto(e.target.closest?.('a[href*="/producto/"]'));
        if (ficha) lista.push({ tipo: 'ficha', clave: ficha });
        const boton = e.target.closest?.('button, [role="button"], [data-evento]');
        if (boton) {
          lista.push({ tipo: 'boton', clave: boton.dataset.evento
            || slug(boton.getAttribute('aria-label') || boton.title || boton.textContent)
            || slug(boton.className) || 'sin-nombre' });
          const cat = boton.dataset.evento && boton.closest('[data-cat]')?.dataset.cat;
          if (cat) lista.push({ tipo: boton.dataset.evento, clave: cat });
        }
        if (lista.length) evento(...lista);
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (cabecera.dataset.menu !== undefined) { cerrarMenu(); hamburguesa.focus(); }
      for (const d of document.querySelectorAll('nav.principal details[open]')) {
        d.open = false;
        d.querySelector('summary').focus();
      }
    });
  </script>
</body>
</html>
