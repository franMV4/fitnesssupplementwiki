---
import Base from '../../layouts/Base.astro';
import TablaProductos from '../../componentes/TablaProductos.jsx';
import Cifras from '../../componentes/Cifras.astro';
import Destacados from '../../componentes/Destacados.astro';
import Aviso from '../../componentes/Aviso.astro';
import Faq from '../../componentes/Faq.astro';
import datos from '../../datos/dataset.json';
import { abs } from '../../sitio.js';
import { eur, paraTabla } from '../../datos/util.js';
import { fechaLarga, listaLd, resumen } from '../../datos/seo.js';
import {
  MEJORES, comparativasDe, descripcionMejores, faqsMejores, mejoresDe, respuestaMejores,
} from '../../datos/landings.js';

// Una pagina por filtro con intencion de compra: "creatina Creapure", "proteina whey de
// Myprotein", "creatina barata". La lista sale de datos/landings.js y no se escribe a
// mano ninguna: ver el comentario de cabecera de ese fichero.
export function getStaticPaths() {
  return MEJORES.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}

const { l } = Astro.props;
const { cat, productos } = l;
const r = resumen(cat, productos);
const respuesta = respuestaMejores(l);
const faqs = faqsMejores(l);
const canonica = abs(`/mejores/${l.slug}`);
// Hermanas: las otras landings de la misma categoria y sus versus. El enlace interno con
// texto que dice la consulta vale mas que un "ver mas", y aqui sale gratis.
const hermanas = mejoresDe(cat.slug).filter((o) => o.slug !== l.slug);
const versus = comparativasDe(cat.slug);

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': canonica,
    url: canonica,
    name: l.titulo,
    description: descripcionMejores(l),
    inLanguage: 'es-ES',
    dateModified: datos.generado,
    isPartOf: { '@id': abs('/#sitio') },
    publisher: { '@id': abs('/#editor') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: cat.nombre, item: abs(`/${cat.slug}`) },
      { '@type': 'ListItem', position: 3, name: l.h1, item: canonica },
    ],
  },
  listaLd(l.titulo, productos),
];
---
<Base ancho="completo" titulo={l.titulo} descripcion={descripcionMejores(l)} schema={schema}>

  <p class="migas">
    <a href="/">Inicio</a> / <a href={`/${cat.slug}`}>{cat.nombre}</a> / seleccion
  </p>

  <section class="cabecera-pagina">
    <p class="antetitulo aparece">
      Seleccion dentro de {cat.nombre.toLowerCase()} · datos del{' '}
      <time datetime={datos.generado}>{fechaLarga(datos.generado)}</time>
    </p>
    <h1 class="aparece d1">{l.h1}</h1>
    {respuesta && <p class="respuesta aparece d2"><b>La respuesta corta.</b> {respuesta}</p>}
    <p class="entradilla aparece d2">{l.criterio}</p>
  </section>

  <Aviso />

  <h2 class="titulo-bloque">Los tres que destacan</h2>
  <Destacados productos={productos} unidad={r.unidad} />

  <h2 id="tabla" class="titulo-bloque">La seleccion completa</h2>
  <div class="aparece d3 tabla-categoria">
    <Cifras n={productos.length} min={r.barato?.precio_referencia}
            max={r.caro?.precio_referencia} unidad={r.unidad} dec={r.dec} nivel4={r.nivel4} />
    <TablaProductos productos={productos.map(paraTabla)} client:visible />
  </div>

  <p class="nota">
    <strong>Esto es un filtro, no otro ranking.</strong> El score que ordena esta tabla es
    exactamente el mismo de <a href={`/${cat.slug}`}>la comparativa completa de {cat.termino}</a>:
    aqui solo se han quitado los productos que no cumplen el criterio de arriba.
    <a href="/metodologia#formula">Como se calcula</a>.
  </p>

  <Faq faqs={faqs} titulo={`Preguntas sobre esta seleccion de ${cat.termino}`} />

  {(hermanas.length > 0 || versus.length > 0) && (
    <section class="seccion">
      <div class="cabecera-seccion">
        <h2>Otras formas de mirar {cat.termino}</h2>
        <p class="apunte">Mismo dataset, otra pregunta</p>
      </div>
      <div class="lista-categorias">
        <a class="fila-categoria" href={`/${cat.slug}`}>
          <span class="nombre">{cat.consultas?.mejor
            ? cat.consultas.mejor.charAt(0).toUpperCase() + cat.consultas.mejor.slice(1)
            : cat.nombre}</span>
          <span class="guia" aria-hidden="true"></span>
          <span class="cuenta">{cat.productos} prod.</span>
        </a>
        {hermanas.map((o) => (
          <a class="fila-categoria" href={`/mejores/${o.slug}`}>
            <span class="nombre">{o.h1.split(':')[0]}</span>
            <span class="guia" aria-hidden="true"></span>
            <span class="cuenta">{o.productos.length} prod.</span>
          </a>
        ))}
        {versus.map((o) => (
          <a class="fila-categoria" href={`/comparativa/${o.slug}`}>
            <span class="nombre">{o.na} o {o.nb} en {cat.termino}</span>
            <span class="guia" aria-hidden="true"></span>
            <span class="cuenta">{o.productos.length} prod.</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
