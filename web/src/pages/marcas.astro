---
import Base from '../layouts/Base.astro';
import datos from '../datos/dataset.json';
import { MARCAS } from '../datos/marcas.js';
import { anio, fechaLarga } from '../datos/seo.js';
import { abs } from '../sitio.js';

// El indice de /marca/*: el unico sitio desde el que se llega a las 98 sin pasar por una
// ficha. Sin el, las paginas de marca solo tendrian enlaces desde fichas con noindex.
const canonica = abs('/marcas');
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': canonica,
    url: canonica,
    name: 'Marcas de suplementos comparadas',
    inLanguage: 'es-ES',
    dateModified: datos.generado,
    isPartOf: { '@id': abs('/#sitio') },
    publisher: { '@id': abs('/#editor') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Marcas', item: canonica },
    ],
  },
];
---
<Base ancho="completo" schema={schema}
      titulo={`Marcas de suplementos ${anio(datos.generado)}: ${MARCAS.length} marcas con precios comparados`}
      descripcion={`Precios de ${MARCAS.length} marcas de suplementos (HSN, Myprotein, Prozis, Optimum Nutrition...) comparados por precio por kilo y certificacion en tiendas espanolas. Datos del ${fechaLarga(datos.generado)}.`}>

  <p class="migas"><a href="/">Inicio</a> / Marcas</p>

  <section class="cabecera-pagina">
    <h1 class="aparece d1">Marcas de suplementos: precios de {MARCAS.length} marcas comparados</h1>
    <p class="respuesta aparece d2">
      <b>La respuesta corta.</b> Cada marca tiene su pagina con todos sus productos, categoria a
      categoria y del mas barato por unidad al mas caro, con la tienda que lo vende. Precios del
      {' '}{fechaLarga(datos.generado)}.
    </p>
  </section>

  <section class="seccion">
    <div class="lista-categorias compacta">
      {MARCAS.map((m) => (
        <a class="fila-categoria" href={`/marca/${m.slug}/`}>
          <span class="nombre">{m.nombre}</span>
          <span class="guia" aria-hidden="true"></span>
          <span class="cuenta">{m.productos.length} prod.</span>
        </a>
      ))}
    </div>
  </section>
</Base>
