---
import Base from '../../layouts/Base.astro';
import datos from '../../datos/dataset.json';
import Faq from '../../componentes/Faq.astro';
import Buscador from '../../componentes/Buscador.jsx';
import ControlPeso from '../../componentes/ControlPeso.jsx';
import Ponderador from '../../componentes/Ponderador.jsx';
import { abs } from '../../sitio.js';
import { NIVEL, puntos } from '../../datos/util.js';
import { anio, resumen } from '../../datos/seo.js';
import { COMPARATIVAS, MEJORES } from '../../datos/landings.js';
import { MARCAS } from '../../datos/marcas.js';
import { categoriasEn, enIdioma } from '../../datos/categorias-i18n.js';
import { LANG, fechaLargaEn, num, porIdioma, ruta, textos, txtBuscador, txtPeso,
         txtPonderador } from '../../i18n.js';

export const getStaticPaths = () => porIdioma();

const { lang } = Astro.props;
const t = textos(lang);
// Enlace interno: el camino se escribe siempre en espanol y sale con el prefijo que toque.
const r = (camino) => ruta(lang, camino);
const fechaLarga = (iso) => fechaLargaEn(lang, iso);

// Los nombres de categoria, traducidos. El slug (y por tanto la URL, el dataset y el
// filtro de productos) sigue siendo el mismo: solo cambia como se lee.
const CATS = categoriasEn(datos.categorias, lang);
const porCategoria = (slug) => datos.productos.filter((p) => p.categoria === slug);
const tiendas = new Set(datos.productos.map((p) => p.tienda)).size;
const conSello = datos.productos.filter((p) => p.sellos.length > 0);

// Una fila por categoria con todo lo que la portada necesita: la horquilla de precios
// y el lider. Se calcula una vez y la usan la tabla ponderable y el JSON-LD.
const portada = CATS.map((c) => {
  const ps = porCategoria(c.slug);
  const r = resumen(c, ps);
  const min = r.barato?.precio_referencia ?? null;
  const max = r.caro?.precio_referencia ?? null;
  // Escala logaritmica: en creatina el techo es 20 veces el suelo, y en lineal los
  // 45 productos se apelotonan en el primer 5 % de la regla. En log se ve donde esta
  // de verdad la mediana y donde cae el lider.
  // Los extremos se recogen un punto hacia dentro: una marca de 3 px justo en el 0 %
  // se sale de la regla por la izquierda y parece un fallo de maquetacion.
  const dentro = (v) => (min != null && max != null && max > min && v != null
    ? Math.min(99, Math.max(1,
        ((Math.log(v) - Math.log(min)) / (Math.log(max) - Math.log(min))) * 100))
    : 0);
  return {
    ...c,
    r,
    unidad: r.unidad,
    dec: r.dec,
    min, max,
    // Donde cae el lider dentro de la horquilla. Si el mejor score esta pegado al suelo,
    // el barato y el bueno son el mismo, y eso se ve sin leer una sola cifra.
    posLider: dentro(r.lider?.precio_referencia),
    posMediana: dentro(r.mediana),
  };
});

// Frontera de Pareto precio/calidad: los unicos productos que pueden liderar su
// categoria con ALGUN peso del score. Es lo que se hidrata en el navegador para la
// tabla ponderable, unas decenas de filas en lugar de 426.
const frenteDe = (ps) => {
  const con = ps.filter((p) => p.precio_referencia != null);
  return con.filter((p) => !con.some((o) => o !== p
    && (o.score_calidad ?? 0) >= (p.score_calidad ?? 0)
    && o.precio_referencia <= p.precio_referencia
    && ((o.score_calidad ?? 0) > (p.score_calidad ?? 0)
        || o.precio_referencia < p.precio_referencia)));
};
const filasPeso = portada.filter((c) => c.r.lider).map((c) => ({
  slug: c.slug,
  nombre: c.nombre,
  unidad: c.unidad_precio,
  suelo: c.min,
  // Lo que antes era la ficha de la seccion "Las 30 comparativas": recuentos y la
  // horquilla de precios. Va debajo de cada fila en vez de en una segunda lista que
  // repetia las mismas 30 categorias con otras palabras.
  productos: c.productos,
  tiendas: c.r.tiendas,
  nivel4: c.r.nivel4,
  min: c.min, max: c.max, mediana: c.r.mediana, dec: c.dec,
  posMediana: c.posMediana,
  // El lider solo se marca si esta despegado del suelo: hoy suele SER el mas barato,
  // y una marca pegada al 0 % no dice nada.
  posLider: c.posLider > 5 ? c.posLider : null,
  candidatos: frenteDe(porCategoria(c.slug)).map((p) => ({
    s: p.slug, marca: p.marca, nombre: p.nombre, tienda: p.tienda, img: p.imagen,
    p: p.precio_referencia, v: p.nivel_verificacion, cal: p.score_calidad ?? 0,
  })),
}));

// La portada ensenaba las CINCUENTA categorias con su ficha entera: 13.070 px de los
// 15.805 que medía la pagina, o sea el 83 %, en una sola lista que nadie recorre hasta
// abajo. Ahora la tabla de lideres se queda con las diez mas surtidas -que son las que
// se buscan- y las otras cuarenta bajan al indice, que las sigue enlazando todas. Ni un
// enlace menos, y una decima parte de pagina.
// Como efecto de propina, al navegador viajan diez frentes de Pareto en vez de cincuenta.
const EN_PORTADA = 10;

// Enlazado interno (09/2026): la portada es la pagina con mas autoridad del dominio y solo
// enlazaba categorias. Las landings de compra (sello, barato, tienda contra tienda) y las
// marcas solo se alcanzaban desde dentro de un <details> de cada categoria, a dos saltos.
// Aqui van las de las categorias mas surtidas, que son las que se buscan.
const TOP_CATS = new Set(filasPeso.slice().sort((a, b) => b.productos - a.productos)
  .slice(0, 8).map((f) => f.slug));
const estrella = [
  ...MEJORES.filter((l) => l.indexable && TOP_CATS.has(l.cat.slug) && !l.tienda)
    .map((l) => ({ href: r(`/mejores/${l.slug}/`), texto: l.h1.split(':')[0], n: l.productos.length })),
  ...CATS.filter((c) => TOP_CATS.has(c.slug))
    .map((c) => COMPARATIVAS.find((l) => l.cat.slug === c.slug)).filter(Boolean)
    .map((l) => ({ href: r(`/comparativa/${l.slug}/`),
                   texto: t('portada.comparativa_vs', l.na, l.nb,
                                  enIdioma(l.cat, lang).termino),
                   n: l.productos.length })),
];
const marcasPortada = MARCAS.filter((m) => m.indexable).slice(0, 24);
const porTamano = (a, b) => b.productos - a.productos;
const destacadas = filasPeso.slice().sort(porTamano).slice(0, EN_PORTADA);
const enDestacadas = new Set(destacadas.map((f) => f.slug));
const restoCategorias = portada.filter((c) => !enDestacadas.has(c.slug)).sort(porTamano);

// La portada responde a la pregunta de arriba del embudo ("que suplementos merecen la
// pena"); cada categoria responde a la suya. Las dos con la misma frase generada.
// El unico parrafo de la portada: es la respuesta que copia un modelo y el fragmento
// que ensena Google, asi que lleva los recuentos, el metodo y la fecha, y nada mas.
const respuesta = t('portada.respuesta', num(lang, datos.productos.length), tiendas,
                    datos.categorias.length, fechaLarga(datos.generado));

const faqs = [
  { p: t('portada.faq1.p'),
    r: t('portada.faq1.r', datos.config.peso_coste * 100, datos.config.peso_calidad * 100) },
  { p: t('portada.faq2.p'), r: t('portada.faq2.r') },
  { p: t('portada.faq3.p'), r: t('portada.faq3.r') },
  { p: t('portada.faq4.p'), r: t('portada.faq4.r', fechaLarga(datos.generado)) },
  { p: t('portada.faq5.p'), r: t('portada.faq5.r') },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': abs(r('/')),
    url: abs(r('/')),
    name: t('portada.schema.pagina'),
    inLanguage: LANG[lang],
    dateModified: datos.generado,
    isPartOf: { '@id': abs('/#sitio') },
    publisher: { '@id': abs('/#editor') },
  },
  {
    '@type': 'ItemList',
    name: t('portada.schema.lista'),
    numberOfItems: datos.categorias.length,
    itemListElement: CATS.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.nombre,
      url: abs(r(`/${c.slug}`)),
    })),
  },
  {
    // La web declarada como lo que es: una base de datos de precios del mercado espanol,
    // no treinta articulos sueltos. Los ficheros de `distribution` ya existian y ya se
    // servian; lo que faltaba era decir que son las descargas de UN dataset con fecha,
    // licencia y autor. Es lo que separa una fuente citable de una pagina mas.
    '@type': 'Dataset',
    '@id': abs('/#dataset'),
    name: t('portada.schema.dataset'),
    description: t('portada.schema.dataset_desc', datos.productos.length, tiendas,
                   datos.categorias.length),
    url: abs(r('/')),
    inLanguage: LANG[lang],
    // La licencia, en la URL canonica de Creative Commons: es la que un agregador de
    // datos abiertos reconoce sin leer nada. Las condiciones en cristiano, en /legal.
    license: 'https://creativecommons.org/licenses/by/4.0/',
    usageInfo: abs('/legal#licencia-datos'),
    creator: { '@id': abs('/#editor') },
    publisher: { '@id': abs('/#editor') },
    isAccessibleForFree: true,
    dateModified: datos.generado,
    // Abierto por la derecha: se vuelve a recoger en cada pasada del robot.
    temporalCoverage: `${datos.generado}/..`,
    spatialCoverage: { '@type': 'Place', name: 'Espana' },
    variableMeasured: t('portada.schema.variables'),
    distribution: [
      { '@type': 'DataDownload', name: t('portada.schema.catalogo'),
        encodingFormat: 'application/json', contentUrl: abs('/datos/catalogo.json') },
      ...CATS.map((c) => ({
        '@type': 'DataDownload', name: c.nombre,
        encodingFormat: 'application/json', contentUrl: abs(`/datos/${c.slug}.json`),
      })),
    ],
  },
];
---
<Base lang={lang} ancho="completo"
      titulo={t('portada.titulo', anio(datos.generado), num(lang, datos.productos.length))}
      descripcion={t('portada.descripcion', num(lang, datos.productos.length), tiendas,
                     datos.categorias.length - 2, fechaLarga(datos.generado))}
      schema={schema}>

  <section class="portada">
    {/* Aqui iba la linea de edicion (fecha, mercado espanol, "el orden no lee el
        fichero de afiliados"). Fuera: la fecha la da la respuesta corta de aqui debajo
        y el colofon del pie; lo del orden y los afiliados lo explican la metodologia y
        el aviso de cada categoria. Eran tres renglones de rotulo antes del titular. */}

    {/* El H1 dice que es esto y con que se compara: son las palabras con las que se
        busca. La frase de marca no se tira, baja a antetitulo, donde hace de gancho sin
        ocupar el sitio de la consulta. */}
    <p class="lema-portada aparece d1">{t('portada.lema')}</p>
    <h1 class="aparece d1">{t('portada.h1')}</h1>

    {/* Entradilla y "respuesta corta" eran dos parrafos que decian lo mismo con otras
        palabras, uno encima del buscador y otro debajo. Van juntos, en uno, y encima:
        debajo del campo solo queda lo que se toca. */}
    <p class="respuesta aparece d2"><b>{t('portada.respuesta_corta')}</b> {respuesta}</p>

    {/* Lo unico que se puede tocar aqui arriba, asi que se hidrata al cargar y no en el
        primer hueco libre: con client:idle las primeras teclas de quien escribe rapido
        se pierden. El indice, en cambio, no viaja en el HTML: se pide al escribir.
        La capa lleva z-index porque la lamina de resultados tiene que taparlo todo:
        cada bloque animado de mas abajo abre su propia capa de pintado. */}
    <div class="capa-buscador aparece d2">
      <Buscador lang={lang} client:load categorias={CATS}
                total={datos.productos.length} txt={txtBuscador(lang)} />
      <ControlPeso client:idle txt={txtPeso(lang)} />
    </div>
  </section>

  <section class="seccion">
    <div class="cabecera-seccion">
      <h2>{t('portada.h2_destacadas', EN_PORTADA)}</h2>
      <p class="apunte">{t('portada.apunte_destacadas', restoCategorias.length)}</p>
    </div>

    {/* La tabla se reordena moviendo el peso del score. Es la metodologia funcionando
        delante del lector: convence mas que jurar que es neutral. */}
    <Ponderador lang={lang} client:visible filas={destacadas} txt={txtPonderador(lang)} />

    <p class="nota">
      <strong>{t('portada.nota_orden')}</strong> {t('portada.nota_orden_cuerpo')}
      {conSello.length > 0 && (
        <>{t('portada.nota_sellos', conSello.length)}
        <a href={r('/metodologia/#sellos')}>{t('portada.criterio_sellos')}</a>.</>
      )}
    </p>
  </section>

  {/* Las otras cuarenta. Antes cada una traia su ficha entera aqui arriba (foto del
      lider, horquilla de precios, recuentos): 260 px por categoria. Aqui son una fila
      con su nombre, su precio de salida y cuantos productos tiene, que es lo que hace
      falta para decidir si se entra. Los cincuenta enlaces siguen en la portada. */}
  <section class="seccion" id="categorias">
    <div class="cabecera-seccion">
      <h2>{t('portada.h2_otras', restoCategorias.length)}</h2>
      <p class="apunte">{t('portada.apunte_otras')}</p>
    </div>
    {/* Cajas y no filas: cuarenta renglones seguidos en tres columnas se leian como un
        listin de telefonos. Cada categoria es una pieza con su borde, su aire y su
        precio de salida, que es el dato con el que se decide si se entra. */}
    <div class="rejilla-categorias">
      {restoCategorias.map((c) => (
        <a class="caja-categoria" href={r(`/${c.slug}/`)}>
          <span class="nombre">{c.nombre}</span>
          {c.min != null && (
            <span class="desde-caja">{t('comun.desde')} <b>{c.min.toFixed(c.dec)} €</b>/{c.unidad}</span>
          )}
          {/* El recuento de tiendas va en su propio span porque en movil la caja mide
              170 px y la linea entera son dos renglones: alli se esconde. */}
          <span class="pie-caja">{t('comun.productos', c.productos)}<span class="tiendas-caja">
            {' '}· {t('comun.tiendas', c.r.tiendas)}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="seccion" id="comparativas">
    <div class="cabecera-seccion">
      <h2>{t('portada.h2_comparativas')}</h2>
      <p class="apunte">{t('portada.apunte_comparativas')}</p>
    </div>
    <div class="lista-categorias compacta">
      {estrella.map((e) => (
        <a class="fila-categoria" href={e.href}>
          <span class="nombre">{e.texto}</span>
          <span class="guia" aria-hidden="true"></span>
          <span class="cuenta">{e.n} {t('comun.prod_corto')}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="seccion" id="marcas">
    <div class="cabecera-seccion">
      <h2>{t('portada.h2_marcas')}</h2>
      <p class="apunte"><a href={r('/marcas/')}>{t('portada.todas_marcas', MARCAS.length)} →</a></p>
    </div>
    <div class="lista-categorias compacta">
      {marcasPortada.map((m) => (
        <a class="fila-categoria" href={r(`/marca/${m.slug}/`)}>
          <span class="nombre">{m.nombre}</span>
          <span class="guia" aria-hidden="true"></span>
          <span class="cuenta">{m.productos.length} {t('comun.prod_corto')}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="seccion negativo">
    <div class="cabecera-seccion">
      <h2>{t('portada.h2_puntuacion')}</h2>
      <p class="apunte">{t('portada.apunte_puntuacion')}</p>
    </div>
    <div class="rejilla">
      <div class="bloque">
        <span class="indice-bloque">01</span>
        <h3>{t('portada.bloque1.h3')}</h3>
        <p>{t('portada.bloque1.p')}</p>
      </div>
      <div class="bloque">
        <span class="indice-bloque">02</span>
        <h3>{t('portada.bloque2.h3')}</h3>
        <p>{t('portada.bloque2.p')}</p>
        {[4, 3, 2, 1].map((n) => (
          <div class={`nivel ${NIVEL[lang][n].clase}`}>
            <span class="puntos">{puntos(n).map((on) => <i class={on ? 'on' : ''} />)}</span>
            {NIVEL[lang][n].etiqueta}
          </div>
        ))}
      </div>
      <div class="bloque">
        <span class="indice-bloque">03</span>
        <h3>{t('portada.bloque3.h3')}</h3>
        <p>{t('portada.bloque3.p')}</p>
        <a href={r('/metodologia/')} class="enlace-accion">{t('comun.leer_metodologia')} →</a>
      </div>
    </div>
  </section>

  <Faq lang={lang} faqs={faqs} titulo={t('portada.faq_titulo')} />
</Base>
