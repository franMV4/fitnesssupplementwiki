---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../componentes/Faq.astro';
import datos from '../../../datos/dataset.json';
import { EVIDENCIA, REVISADO } from '../../../datos/evidencia.js';
import { evidenciaEn, nivelEvidencia } from '../../../datos/evidencia-i18n.js';
import { enIdioma } from '../../../datos/categorias-i18n.js';
import { metodo } from '../../../datos/metodologia.js';
import { abs } from '../../../sitio.js';
import { eur, UNIDAD } from '../../../datos/util.js';
import { LANG, fechaLargaEn, porIdioma, ruta, textos } from '../../../i18n.js';

// La guia y la comparativa son dos paginas a proposito: /creatina responde "que creatina
// comprar" (quiero comprar) y /guia/creatina responde "para que sirve la creatina" (quiero
// entender). Una consulta por pagina, que es la regla de SEO-PRODUCTOS.md; meterlo todo en
// /creatina haria que compitiera consigo misma por dos intenciones distintas.
export function getStaticPaths() {
  // Solo las categorias con evidencia escrita: una categoria nueva no genera una guia
  // vacia, se queda sin guia hasta que alguien escriba la suya con sus fuentes.
  return porIdioma(datos.categorias
    .filter((c) => EVIDENCIA[c.slug])
    .map((c) => ({
      params: { categoria: c.slug },
      props: { catEs: c, productos: datos.productos.filter((p) => p.categoria === c.slug) },
    })));
}

const { catEs, productos, lang } = Astro.props;
const t = textos(lang);
const r = (camino) => ruta(lang, camino);
const fechaLarga = (iso) => fechaLargaEn(lang, iso);
const cat = enIdioma(catEs, lang);
// La guia en el idioma de la pagina, montada campo a campo sobre la espanola: cifras,
// fuentes y nivel salen siempre del espanol (ver datos/evidencia-i18n.js).
const ev = evidenciaEn(cat.slug, lang);

// Invariante 4 de AGENTS.md, comprobado donde no puede rotar: ninguna cifra sin fuente.
// Si un efecto apunta a una fuente que no existe, revienta el build en vez de publicar un
// porcentaje colgando de un [3] que no lleva a ninguna parte.
for (const e of ev.efectos) {
  for (const i of e.f) {
    if (!ev.fuentes[i]) throw new Error(`${cat.slug}: "${e.que}" cita la fuente ${i + 1}, que no existe`);
  }
  if (!e.f.length) throw new Error(`${cat.slug}: "${e.que}" no cita ninguna fuente`);
}

const unidad = UNIDAD[lang][cat.unidad_precio] ?? 'kg';
const dec = unidad === 'kg' ? 2 : 3;
const precios = productos.map((p) => p.precio_referencia).filter((n) => n != null);
const barato = precios.length ? Math.min(...precios) : null;
const tiendas = new Set(productos.map((p) => p.tienda)).size;
const nivel = nivelEvidencia(ev.nivel, lang);
const canonica = abs(r(`/guia/${cat.slug}`));

const secciones = [
  { id: 'efectos', titulo: t('guia.idx_efectos') },
  { id: 'protocolo', titulo: t('guia.idx_protocolo') },
  { id: 'situaciones', titulo: t('guia.idx_situaciones') },
  { id: 'fuentes', titulo: t('guia.idx_fuentes') },
];

const schema = [
  {
    // Article y no MedicalWebPage: esto es divulgacion sobre un ingrediente con sus citas,
    // no consejo clinico, y marcarlo como medico invita a un escrutinio que no toca.
    '@type': 'Article',
    '@id': `${canonica}#articulo`,
    headline: ev.h1,
    description: ev.descripcion,
    inLanguage: LANG[lang],
    mainEntityOfPage: canonica,
    // dateModified es de ESTE texto, no de la recogida de precios: son dos frescuras
    // distintas y mezclarlas seria decir que las cifras se revisaron cuando no.
    dateModified: REVISADO,
    author: { '@id': abs('/#editor') },
    publisher: { '@id': abs('/#editor') },
    isPartOf: { '@id': abs('/#sitio') },
    about: { '@type': 'Thing', name: cat.termino },
    citation: ev.fuentes.map((f) => ({ '@type': 'CreativeWork', name: f.cita, url: f.url })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('comun.inicio'), item: abs(r('/')) },
      { '@type': 'ListItem', position: 2, name: cat.nombre, item: abs(r(`/${cat.slug}`)) },
      { '@type': 'ListItem', position: 3, name: t('guia.miga'), item: canonica },
    ],
  },
];
const otras = datos.categorias.filter((c) => c.slug !== cat.slug && EVIDENCIA[c.slug]);
---
<Base lang={lang} ancho="completo" titulo={ev.titulo} descripcion={ev.descripcion} schema={schema}>

  <p class="migas"><a href={r('/')}>{t('comun.inicio')}</a> / <a href={r(`/${cat.slug}/`)}>{cat.nombre}</a> / {t('guia.miga')}</p>

  <section class="cabecera-pagina">
    <p class="antetitulo aparece">{cat.nombre} · {nivel.etiqueta}</p>
    <h1 class="aparece d1">{ev.h1}</h1>
    <p class="respuesta aparece d2"><b>{t('portada.respuesta_corta')}</b> {ev.resumen}</p>
    <p class="entradilla aparece d2">{nivel.explica}{t('guia.no_producto')}</p>
  </section>

  <div class="con-carril">
    <aside class="indice carril">
      <p class="rotulo">{metodo(lang)('contenido')}</p>
      <ol>{secciones.map((s) => <li><a href={`#${s.id}`}>{s.titulo}</a></li>)}</ol>
      <p class="rotulo" style="margin-top:1.5rem">{t('guia.revisado')}</p>
      <p class="mono"><time datetime={REVISADO}>{fechaLarga(REVISADO)}</time></p>
    </aside>

    <div class="prosa">
      <section id="efectos" class="seccion-doc">
        <h2><span class="num">01</span> {t('guia.idx_efectos')}</h2>
        <p>{t('guia.efectos_p')}</p>
        <div class="tabla-marco">
          <div class="tabla-scroll">
            <table class="apilable">
              <caption>{t('guia.caption', cat.termino)}</caption>
              <thead>
                <tr><th>{t('guia.col_efecto')}</th><th>{t('guia.col_cuanto')}</th><th>{t('guia.col_detalle')}</th></tr>
              </thead>
              <tbody>
                {ev.efectos.map((e) => (
                  <tr>
                    <td class="principal" data-et={t('guia.col_efecto')}>{e.que}</td>
                    <td data-et={t('guia.col_cuanto')}><b class="cifra">{e.cifra}</b></td>
                    <td data-et={t('guia.col_detalle')}>
                      {e.detalle}{' '}
                      {e.f.map((i) => (
                        <a class="ref" href={`#fuente-${i + 1}`} aria-label={t('guia.fuente_n', i + 1)}>[{i + 1}]</a>
                      ))}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="protocolo" class="seccion-doc">
        <h2><span class="num">02</span> {t('guia.idx_protocolo')}</h2>
        <ul>
          <li><strong>{t('guia.dosis')}</strong> {ev.protocolo.dosis}</li>
          <li><strong>{t('guia.cuando')}</strong> {ev.protocolo.cuando}</li>
          <li><strong>{t('guia.tarda')}</strong> {ev.protocolo.tarda}</li>
        </ul>
        <h3>{t('guia.detalles')}</h3>
        <ul>{ev.protocolo.notas.map((n) => <li>{n}</li>)}</ul>
      </section>

      <section id="situaciones" class="seccion-doc">
        <h2><span class="num">03</span> {t('guia.h2_situaciones')}</h2>
        <div class="rejilla">
          <div class="bloque">
            <h3>{t('guia.compensa')}</h3>
            <ul>{ev.cuando_si.map((s) => <li>{s}</li>)}</ul>
          </div>
          <div class="bloque">
            <h3>{t('guia.no_compensa')}</h3>
            <ul>{ev.cuando_no.map((s) => <li>{s}</li>)}</ul>
          </div>
        </div>
      </section>

      <section id="fuentes" class="seccion-doc">
        <h2><span class="num">04</span> {t('guia.idx_fuentes')}</h2>
        <p>{t('guia.fuentes_p')}</p>
        <ol class="fuentes">
          {ev.fuentes.map((f, i) => (
            <li id={`fuente-${i + 1}`}>
              {f.cita} <a href={f.url} rel="nofollow noopener" target="_blank">{f.url.replace('https://doi.org/', 'doi:')}</a>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>

  <p class="nota"><strong>{t('guia.no_medico_t')}</strong>{t('guia.no_medico')}</p>

  <Faq lang={lang} faqs={ev.faqs} titulo={t('cat.faq_titulo', cat.termino)} />

  <section class="seccion">
    <div class="cabecera-seccion">
      <h2>{t('guia.h2_comprar')}</h2>
      <p class="apunte">{t('guia.apunte_comprar')}</p>
    </div>
    <p class="prosa">
      {t('guia.comprar_p', cat.termino, productos.length, t('comun.tiendas', tiendas))}
      {barato != null && t('guia.comprar_desde', eur(barato, dec, lang), unidad)}{t('guia.comprar_cola')}
    </p>
    <p><a class="boton" href={r(`/${cat.slug}/`)}>{t('guia.ver_comparativa', cat.nombre.toLowerCase())}</a></p>
  </section>

  <section class="seccion">
    <div class="cabecera-seccion">
      <h2>{t('guia.h2_otras')}</h2>
      <p class="apunte">{t('guia.apunte_otras')}</p>
    </div>
    <div class="lista-categorias">
      {otras.map((c) => {
        const o = evidenciaEn(c.slug, lang);
        return (
          <a class="fila-categoria" href={r(`/guia/${c.slug}/`)}>
            <span class="nombre">{o.h1}</span>
            <span class="guia" aria-hidden="true"></span>
            <span class="cuenta">{nivelEvidencia(o.nivel, lang).etiqueta}</span>
          </a>
        );
      })}
    </div>
  </section>
</Base>

<style>
  /* Marcador de fuente: un numero pequeno que no rompe la linea de texto. */
  .ref { font-size: .75rem; vertical-align: super; text-decoration: none; margin-left: .1rem; }
  .fuentes { padding-left: 1.2rem; margin: 0; max-width: 48rem; }
  .fuentes li { color: var(--tinta-2); font-size: .85rem; line-height: 1.5; margin-bottom: var(--e3); }
  .fuentes a { word-break: break-word; }
  /* La rejilla de "compensa / no compensa" hereda .bloque, solo necesita respirar. */
  .prosa .rejilla { gap: var(--e5); margin-bottom: var(--e5); }
  .prosa .rejilla ul { margin-bottom: 0; }
</style>
