---
import Base from '../../../layouts/Base.astro';
import TablaProductos from '../../../componentes/TablaProductos.astro';
import CaraACara from '../../../componentes/CaraACara.astro';
import Aviso from '../../../componentes/Aviso.astro';
import Faq from '../../../componentes/Faq.astro';
import datos from '../../../datos/dataset.json';
import { abs } from '../../../sitio.js';
import { NIVEL, paraTabla, precioReferencia, puntos } from '../../../datos/util.js';
import { agregadoLd, listaLd, nom, resumen } from '../../../datos/seo.js';
import { enIdioma } from '../../../datos/categorias-i18n.js';
import { LANG, fechaLargaEn, porIdioma, ruta, textos } from '../../../i18n.js';
import {
  COMPARATIVAS, comparativasDe, descripcionComparativa, faqsComparativa, mejoresDe,
  respuestaComparativa, textosComparativa, textosMejores,
} from '../../../datos/landings.js';

// "HSN o Myprotein" en una categoria. La pagina existe porque esa consulta no la responde
// bien una tabla de 120 filas: quien la busca ya eligio categoria y solo quiere el
// desempate. Ver datos/landings.js.
export function getStaticPaths() {
  return porIdioma(COMPARATIVAS.map((l) => ({ params: { slug: l.slug }, props: { l } })));
}

const { l, lang } = Astro.props;
const t = textos(lang);
const r_ = (camino) => ruta(lang, camino);
const fechaLarga = (iso) => fechaLargaEn(lang, iso);
const cat = enIdioma(l.cat, lang);
const { na, nb } = l;
// Los resumenes en el idioma de la pagina: la unidad ("capsule", "gélule") y el formato
// del euro cambian, los numeros no.
const ra = resumen(l.cat, l.pa, lang);
const rb = resumen(l.cat, l.pb, lang);
const tx = textosComparativa(l, lang);
const respuesta = respuestaComparativa(l, lang);
const faqs = faqsComparativa(l, lang);
const descripcion = descripcionComparativa(l, lang);
const canonica = abs(r_(`/comparativa/${l.slug}`));
const hermanas = comparativasDe(cat.slug).filter((o) => o.slug !== l.slug);
const selecciones = mejoresDe(cat.slug);

// Las dos tiendas, fila a fila y con el mismo criterio: es la tabla que la gente se hace
// a mano en una hoja de calculo antes de comprar.
const lados = [
  { n: na, r: ra, url: r_(`/mejores/${cat.slug}-de-${l.a}/`) },
  { n: nb, r: rb, url: r_(`/mejores/${cat.slug}-de-${l.b}/`) },
];

const agregado = agregadoLd(tx.titulo, l.productos, canonica);
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': canonica,
    url: canonica,
    name: tx.titulo,
    description: descripcion,
    inLanguage: LANG[lang],
    dateModified: datos.generado,
    isPartOf: [{ '@id': abs('/#sitio') }, { '@id': abs('/#dataset') }],
    publisher: { '@id': abs('/#editor') },
    // La horquilla de la tabla entera, no solo la de los diez de la ItemList.
    ...(agregado ? { mainEntity: agregado } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('comun.inicio'), item: abs(r_('/')) },
      { '@type': 'ListItem', position: 2, name: cat.nombre, item: abs(r_(`/${cat.slug}`)) },
      { '@type': 'ListItem', position: 3, name: `${na} vs ${nb}`, item: canonica },
    ],
  },
  listaLd(tx.titulo, l.productos),
];
---
<Base lang={lang} ancho="completo" titulo={tx.titulo} descripcion={descripcion} schema={schema}>

  <p class="migas">
    <a href={r_('/')}>{t('comun.inicio')}</a> / <a href={r_(`/${cat.slug}/`)}>{cat.nombre}</a> / {na} vs {nb}
  </p>

  <section class="cabecera-pagina">
    <p class="antetitulo aparece">
      {t('land.cara_a_cara')} · {t('cat.datos_del')}{' '}
      <time datetime={datos.generado}>{fechaLarga(datos.generado)}</time>
    </p>
    <h1 class="aparece d1">{tx.h1}</h1>
    {respuesta && <p class="respuesta aparece d2"><b>{t('portada.respuesta_corta')}</b> {respuesta}</p>}
    <p class="entradilla aparece d2">{t('land.vs_entradilla', ra.unidad)}</p>
  </section>

  <Aviso lang={lang} />

  <h2 class="titulo-bloque">{t('land.vistazo')}</h2>
  <div class="destacados aparece d2">
    {lados.map((lado) => (
      <div class="bloque destacado-bloque">
        <span class="rotulo-destacado">{lado.n}</span>
        <h3><a href={lado.url}>{t('land.n_productos_de', lado.r.n, cat.termino)}</a></h3>
        <p class="linea-destacado">
          <span class="cifra">{lado.r.precio(lado.r.mediana)}</span>
          <span class="sutil">{t('land.mediana')}</span>
        </p>
        <p>
          {t('land.de_a', lado.r.precio(lado.r.barato?.precio_referencia),
             lado.r.precio(lado.r.caro?.precio_referencia), lado.r.nivel4, lado.r.nivel3)}
        </p>
        {lado.r.lider && (
          <p class="sutil">
            {t('land.su_mejor')} <a href={`/producto/${lado.r.lider.slug}/`}>{nom(lado.r.lider)}</a>,
            {' '}{lado.r.lider.score_final?.toFixed(0)}/100 {t('land.a_precio')}
            {' '}{precioReferencia(lado.r.lider, lang).valor}/{precioReferencia(lado.r.lider, lang).unidad}.
          </p>
        )}
      </div>
    ))}
  </div>

  <section class="seccion">
    <div class="cabecera-seccion">
      <h2>{t('land.frente', na, nb)}</h2>
      <p class="apunte">{t('land.mismos_numeros')}</p>
    </div>
    <div class="tabla-marco">
      <div class="tabla-scroll">
        <table class="apilable">
          <caption>{t('land.caption_vs', na, nb, cat.termino, fechaLarga(datos.generado))}</caption>
          <thead>
            <tr>
              <th>{t('land.dato')}</th>
              <th class="num">{na}</th>
              <th class="num">{nb}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="principal marca">{t('land.f_productos')}</td>
              <td class="num" data-et={na}>{ra.n}</td>
              <td class="num" data-et={nb}>{rb.n}</td>
            </tr>
            <tr>
              <td class="principal marca">{t('land.f_mediana', ra.unidad)}</td>
              <td class={`num ${ra.mediana <= rb.mediana ? 'destacado' : ''}`} data-et={na}>{ra.precio(ra.mediana)}</td>
              <td class={`num ${rb.mediana < ra.mediana ? 'destacado' : ''}`} data-et={nb}>{rb.precio(rb.mediana)}</td>
            </tr>
            <tr>
              <td class="principal marca">{t('land.f_barato', ra.unidad)}</td>
              <td class="num" data-et={na}>{ra.precio(ra.barato?.precio_referencia)}</td>
              <td class="num" data-et={nb}>{rb.precio(rb.barato?.precio_referencia)}</td>
            </tr>
            <tr>
              <td class="principal marca">{t('land.f_caro', ra.unidad)}</td>
              <td class="num" data-et={na}>{ra.precio(ra.caro?.precio_referencia)}</td>
              <td class="num" data-et={nb}>{rb.precio(rb.caro?.precio_referencia)}</td>
            </tr>
            <tr>
              <td class="principal marca">{t('land.f_score')}</td>
              <td class="num" data-et={na}>{ra.lider?.score_final?.toFixed(0) ?? '—'}</td>
              <td class="num" data-et={nb}>{rb.lider?.score_final?.toFixed(0) ?? '—'}</td>
            </tr>
            <tr>
              <td class="principal marca">{t('land.f_n4')}</td>
              {[{ r: ra, n: na }, { r: rb, n: nb }].map((lado) => (
                <td data-et={lado.n} class={lado.r.nivel4 === 0 ? 'num' : ''}>
                  {lado.r.nivel4 === 0 ? t('land.de', 0, lado.r.n) : (
                    <span class={`nivel ${NIVEL[lang][4].clase}`}>
                      <span class="puntos">{puntos(4).map((on) => <i class={on ? 'on' : ''} />)}</span>
                      {t('land.de', lado.r.nivel4, lado.r.n)}
                    </span>
                  )}
                </td>
              ))}
            </tr>
            <tr>
              <td class="principal marca">{t('land.f_n3')}</td>
              <td class="num" data-et={na}>{t('land.de', ra.nivel3, ra.n)}</td>
              <td class="num" data-et={nb}>{t('land.de', rb.nivel3, rb.n)}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="nota"><strong>{t('land.mediana_nota_t')}</strong>{t('land.mediana_nota')}</p>
  </section>

  <CaraACara lang={lang} cat={l.cat} ladoA={{ nombre: na, productos: l.pa }} ladoB={{ nombre: nb, productos: l.pb }} />

  <section class="seccion">
    <div class="cabecera-seccion">
      <h2>{t('land.todos_productos', l.productos.length)}</h2>
      <p class="apunte">{t('land.filtra')}</p>
    </div>
    <TablaProductos lang={lang} productos={l.productos.map(paraTabla)} />
  </section>

  <Faq lang={lang} faqs={faqs} titulo={t('land.faq_vs', na, nb, cat.termino)} />

  <section class="seccion">
    <div class="cabecera-seccion">
      <h2>{t('land.seguir', cat.termino)}</h2>
      <p class="apunte">{t('land.mismo_dataset')}</p>
    </div>
    <div class="lista-categorias">
      <a class="fila-categoria" href={r_(`/${cat.slug}/`)}>
        <span class="nombre">{cat.consultas?.mejor
          ? cat.consultas.mejor.charAt(0).toUpperCase() + cat.consultas.mejor.slice(1)
          : cat.nombre}</span>
        <span class="guia" aria-hidden="true"></span>
        <span class="cuenta">{cat.productos} {t('comun.prod_corto')}</span>
      </a>
      {hermanas.map((o) => (
        <a class="fila-categoria" href={r_(`/comparativa/${o.slug}/`)}>
          <span class="nombre">{t('portada.comparativa_vs', o.na, o.nb, cat.termino)}</span>
          <span class="guia" aria-hidden="true"></span>
          <span class="cuenta">{o.productos.length} {t('comun.prod_corto')}</span>
        </a>
      ))}
      {selecciones.map((o) => (
        <a class="fila-categoria" href={r_(`/mejores/${o.slug}/`)}>
          <span class="nombre">{textosMejores(o, lang).h1.split(':')[0].trim()}</span>
          <span class="guia" aria-hidden="true"></span>
          <span class="cuenta">{o.productos.length} {t('comun.prod_corto')}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
