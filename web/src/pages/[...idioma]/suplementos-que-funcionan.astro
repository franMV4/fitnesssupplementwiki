---
import Base from '../../layouts/Base.astro';
import Aviso from '../../componentes/Aviso.astro';
import Faq from '../../componentes/Faq.astro';
import datos from '../../datos/dataset.json';
import { REVISADO } from '../../datos/evidencia.js';
import { EFICACIA, NIVELES, RECUENTO, OBJETIVOS, porNivel } from '../../datos/eficacia.js';
import { evidenciaEn, nivelEvidencia } from '../../datos/evidencia-i18n.js';
import { enIdioma } from '../../datos/categorias-i18n.js';
import { eur } from '../../datos/util.js';
import { nom } from '../../datos/seo.js';
import { abs } from '../../sitio.js';
import { LANG, fechaLargaEn, porIdioma, ruta, textos } from '../../i18n.js';

export const getStaticPaths = () => porIdioma();

const { lang } = Astro.props;
const t = textos(lang);
const r = (camino) => ruta(lang, camino);
const fechaLarga = (iso) => fechaLargaEn(lang, iso);

// "Los mejores suplementos" / "cuales funcionan de verdad": la consulta de cabecera de
// todo el tema. La pagina existe porque la respuesta honesta no cabe en una tabla de
// precios: son treinta ingredientes repartidos en tres niveles de evidencia, y la mitad
// de la utilidad esta en el tercer nivel, el de los que casi nadie te va a desaconsejar.
//
// No hay ranking del 1 al 10. Ordenar "creatina, whey, cafeina..." por eficacia seria
// inventarse una escala que no existe: hacen cosas distintas. Lo que si se ordena es la
// evidencia (que es una propiedad del ingrediente) y el coste al mes (que es un dato).
const canonica = abs(r('/suplementos-que-funcionan'));
const mes = (n) => (n == null ? null : eur(n, 2, lang));
// EFICACIA sale en espanol (nombre, dosis y efecto de cada guia). Aqui se viste en el
// idioma de la pagina: el efecto se busca por POSICION dentro de la guia traducida, que es
// como evidencia-i18n.js empareja los efectos, asi que la cifra es la misma en los tres.
const vestir = (x) => {
  const ev = evidenciaEn(x.slug, lang);
  const i = x.efecto ? evidenciaEn(x.slug, 'es').efectos.indexOf(x.efecto) : -1;
  return {
    ...x,
    cat: enIdioma(x.cat, lang),
    dosis: x.dosis ? ev.protocolo.dosis : null,
    efecto: i >= 0 ? ev.efectos[i] : x.efecto,
  };
};
const nivel = (n) => porNivel(n).map(vestir);
const conPrecio = EFICACIA.filter((x) => x.alMes != null).map(vestir);
const masBarato = conPrecio[0] ?? null;
const lista = (n) => nivel(n).map((x) => x.cat.nombre.toLowerCase()).join(', ');

const faqs = [
  { p: t('funciona.faq1.p'), r: t('funciona.faq1.r', RECUENTO.alta, lista('alta'), RECUENTO.media, RECUENTO.baja) },
  {
    p: t('funciona.faq2.p'),
    r: masBarato ? t('funciona.faq2.r', masBarato.cat.nombre, mes(masBarato.alMes)) : t('funciona.faq2.r_sin'),
  },
  { p: t('funciona.faq3.p'), r: t('funciona.faq3.r', fechaLarga(REVISADO), fechaLarga(datos.generado)) },
  { p: t('funciona.faq4.p'), r: t('funciona.faq4.r', RECUENTO.baja, lista('baja')) },
];

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': canonica,
    url: canonica,
    name: t('funciona.h1'),
    inLanguage: LANG[lang],
    dateModified: datos.generado,
    isPartOf: [{ '@id': abs('/#sitio') }, { '@id': abs('/#dataset') }],
    publisher: { '@id': abs('/#editor') },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('comun.inicio'), item: abs(r('/')) },
      { '@type': 'ListItem', position: 2, name: t('funciona.miga'), item: canonica },
    ],
  },
];
---
<Base lang={lang} ancho="completo" schema={schema}
      titulo={t('funciona.titulo', RECUENTO.alta)}
      descripcion={t('funciona.descripcion', EFICACIA.length, RECUENTO.alta, RECUENTO.media, RECUENTO.baja)}>

  <p class="migas"><a href={r('/')}>{t('comun.inicio')}</a> / {t('funciona.miga')}</p>

  <section class="cabecera-pagina">
    <p class="antetitulo aparece">
      {t('funciona.antetitulo_ev')} <time datetime={REVISADO}>{fechaLarga(REVISADO)}</time> ·
      {' '}{t('funciona.antetitulo_pr')} <time datetime={datos.generado}>{fechaLarga(datos.generado)}</time>
    </p>
    <h1 class="aparece d1">{t('funciona.h1')}</h1>
    <p class="respuesta aparece d2">
      <b>{t('portada.respuesta_corta')}</b> {t('funciona.respuesta', EFICACIA.length, RECUENTO.alta, RECUENTO.media, RECUENTO.baja)}{masBarato && t('funciona.respuesta_barato', masBarato.cat.nombre.toLowerCase(), mes(masBarato.alMes))}{t('funciona.respuesta_cola')}
    </p>
    <p class="entradilla aparece d2">{t('funciona.entradilla')}</p>
  </section>

  <Aviso lang={lang} />

  {Object.keys(NIVELES).map((n, i) => {
    const meta = nivelEvidencia(n, lang);
    return (
    <section class="seccion" id={n}>
      <div class="cabecera-seccion">
        <h2><span class="num">{String(i + 1).padStart(2, '0')}</span> {t('funciona.h2_nivel', meta.etiqueta, porNivel(n).length)}</h2>
        <p class="apunte">{t('funciona.apunte_nivel')}</p>
      </div>
      <p class="sutil">{meta.explica}</p>
      <div class="tabla-marco">
        <div class="tabla-scroll">
          <table class="apilable">
            <caption>{t('funciona.caption', meta.etiqueta.toLowerCase())}</caption>
            <thead>
              <tr>
                <th>{t('funciona.col_suplemento')}</th>
                <th>{t('funciona.col_medido')}</th>
                <th class="num">{t('funciona.col_mes')}</th>
                <th class="num">{t('tiendas.col_productos')}</th>
              </tr>
            </thead>
            <tbody>
              {nivel(n).map((x) => (
                <tr>
                  <td class="principal marca">
                    <a href={r(`/guia/${x.slug}/`)}>{x.cat.nombre}</a>
                    {x.dosis && <span class="explica">{x.dosis}</span>}
                  </td>
                  <td data-et={t('funciona.col_medido')}>
                    {x.efecto ? <>{x.efecto.que}: <strong>{x.efecto.cifra}</strong></> : '—'}
                    {x.fuente && <span class="explica">{x.fuente.cita}</span>}
                  </td>
                  <td class="num" data-et={t('funciona.col_mes')}>
                    {x.alMes != null ? (
                      <>
                        <span class="destacado">{mes(x.alMes)}</span>
                        <span class="explica">{t('funciona.con_de', nom(x.barato), x.tiendaBarato)}</span>
                      </>
                    ) : (
                      <span class="sutil">{t('funciona.sin_dosis')}</span>
                    )}
                  </td>
                  <td class="num" data-et={t('tiendas.col_productos')}>
                    <a href={r(`/${x.slug}/`)}>{x.productos}</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
    );
  })}

  <p class="nota"><strong>{t('funciona.nota_t')}</strong>{t('funciona.nota')}</p>

  <section class="seccion">
    <div class="cabecera-seccion">
      <h2>{t('funciona.h2_objetivo')}</h2>
      <p class="apunte">{t('funciona.apunte_objetivo')}</p>
    </div>
    <div class="lista-categorias">
      {OBJETIVOS.map((o) => (
        <a class="fila-categoria" href={r(`/para/${o.slug}/`)}>
          <span class="nombre">{t(`objetivo.${o.slug}.nombre`)}</span>
          <span class="guia" aria-hidden="true"></span>
          <span class="cuenta">{t('funciona.n_suplementos', o.incluye.length)}</span>
        </a>
      ))}
      <a class="fila-categoria" href={r('/tiendas/')}>
        <span class="nombre">{t('funciona.donde_barato')}</span>
        <span class="guia" aria-hidden="true"></span>
        <span class="cuenta">{t('funciona.tiendas')}</span>
      </a>
    </div>
  </section>

  <Faq lang={lang} faqs={faqs} titulo={t('funciona.faq_titulo')} />
</Base>
