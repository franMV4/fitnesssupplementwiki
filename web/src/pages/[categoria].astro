---
import Base from '../layouts/Base.astro';
import TablaProductos from '../componentes/TablaProductos.astro';
import Aviso from '../componentes/Aviso.astro';
import Cifras from '../componentes/Cifras.astro';
import Faq from '../componentes/Faq.astro';
import datos from '../datos/dataset.json';
import { EVIDENCIA } from '../datos/evidencia.js';
import { abs } from '../sitio.js';
import { eur, paraTabla, UNIDAD } from '../datos/util.js';
import {
  agregadoLd, descripcionCategoria, faqsCategoria, fechaLarga, h1Categoria, listaLd,
  respuestaCategoria, tituloCategoria,
} from '../datos/seo.js';
import { comparativasDe, mejoresDe } from '../datos/landings.js';

export function getStaticPaths() {
  return datos.categorias.map((c) => ({
    params: { categoria: c.slug },
    props: { cat: c, productos: datos.productos.filter((p) => p.categoria === c.slug) },
  }));
}

const { cat, productos } = Astro.props;
const nombre = cat.nombre;
const unidad = UNIDAD[cat.unidad_precio] ?? 'kg';
const conDosis = cat.con_dosis;
const verificados = productos.filter((p) => p.nivel_verificacion === 4).length;
const tiendas = new Set(productos.map((p) => p.tienda)).size;
const precios = productos.map((p) => p.precio_referencia).filter((n) => n != null);
const barato = precios.length ? Math.min(...precios) : null;
const caro = precios.length ? Math.max(...precios) : null;
const dec = unidad === 'kg' ? 2 : 3;

// El H1 lleva delante la palabra clave del producto y detras las dos por las que se
// busca esta web (precio por unidad y certificacion): "La mejor creatina de 2026:
// comparativa por precio por kg y certificacion". La consulta declarada en categorias.py
// ("que creatina comprar") no se pierde: sigue siendo la primera pregunta del FAQ de esta
// misma pagina, que es donde Google la lee para el fragmento destacado.
const consulta = cat.consultas?.mejor;
const h1 = h1Categoria(cat, datos.generado);
// Landings de intencion de esta categoria (datos/landings.js).
const selecciones = mejoresDe(cat.slug);
const versus = comparativasDe(cat.slug);
const respuesta = respuestaCategoria(cat, productos, datos.generado);
const faqs = faqsCategoria(cat, productos, datos.dosis_referencia, datos.generado);
const otras = datos.categorias.filter((c) => c.slug !== cat.slug);
const canonica = abs(`/${cat.slug}`);
// La guia de la categoria, si esta escrita. Esta pagina compara precios; la guia explica
// que hace el ingrediente y con que fuente. Se enlazan entre si y no compiten: una responde
// "cual compro" y la otra "para que sirve".
const guia = EVIDENCIA[cat.slug];

// Los diez primeros con su oferta. Mas no aporta: nadie lee una ItemList de 118. La
// horquilla de los otros ciento ocho no se pierde: va en el AggregateOffer.
const agregado = agregadoLd(
  `${nombre} en las tiendas comparadas`, productos, canonica);
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': canonica,
    url: canonica,
    name: tituloCategoria(cat, datos.generado),
    description: descripcionCategoria(cat, productos, datos.generado),
    inLanguage: 'es-ES',
    dateModified: datos.generado,
    // Del sitio y, ademas, del dataset que se declara en la portada: estas treinta
    // tablas no son treinta articulos sueltos, son las particiones de una misma base
    // de datos. Es lo que hace que un modelo cite "la fuente" y no "una pagina".
    isPartOf: [{ '@id': abs('/#sitio') }, { '@id': abs('/#dataset') }],
    publisher: { '@id': abs('/#editor') },
    // La horquilla de la categoria ENTERA, no solo la de los diez que van en la
    // ItemList. Es el dato del fragmento: "de 12 a 68 EUR en 8 tiendas".
    ...(agregado ? { mainEntity: agregado } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: nombre, item: canonica },
    ],
  },
  listaLd(`${nombre}: ranking por precio por ${unidad} y certificacion`, productos),
];
---
<Base ancho="completo"
      titulo={tituloCategoria(cat, datos.generado)}
      descripcion={descripcionCategoria(cat, productos, datos.generado)}
      schema={schema}>

  <p class="migas"><a href="/">Inicio</a> / {nombre}</p>

  <section class="cabecera-pagina">
    <p class="antetitulo aparece">
      {consulta ? consulta.charAt(0).toUpperCase() + consulta.slice(1) : nombre} · datos del{' '}
      <time datetime={datos.generado}>{fechaLarga(datos.generado)}</time>
    </p>
    <h1 class="aparece d1">{h1}</h1>
    {respuesta && (
      <p class="respuesta aparece d2">
        <b>La respuesta corta.</b> {respuesta}
      </p>
    )}
    {/* Aqui iba un parrafo con el reparto del score ("35 % precio por kg frente al mas
        barato, 35 % calidad verificable, 20 %...") y otro con el enlace a la guia. El
        primero decia palabra por palabra lo mismo que la nota que va DEBAJO de la tabla
        ("Que estas mirando"), o sea que la pagina explicaba su formula dos veces antes
        de ensenar un solo precio. El segundo era tres renglones para un enlace.
        Los dos costaban ~200 px por encima de la tabla, que es lo unico a lo que se
        viene. El enlace se queda, en una linea. */}
    {guia && (
      <p class="pase-guia aparece d2">
        <a href={`/guia/${cat.slug}/`}>Que hace {cat.termino}, en que dosis y con que
        evidencia</a> — aqui solo estan los precios.
      </p>
    )}
  </section>

  <Aviso />

  {!conDosis && (
    <p class="nota">
      <strong>De la formula de esta categoria no se afirma nada.</strong> Ninguna de estas
      tiendas publica cuanto activo lleva cada dosis, asi que el score sale del precio por
      {' '}{unidad} y del nivel de verificacion, y nadie aparece aqui como bien o mal
      dosificado: no tenemos el dato y no nos lo inventamos.
    </p>
  )}

  {/* El titulo y las tres cifras van en la MISMA linea, no uno encima del otro: son la
      cabecera de la tabla, no dos bloques. Apilados costaban 157 px justo donde mas
      caro sale, entre el titular de la pagina y la primera fila de datos. */}
  <div class="cabecera-tabla titulo-bloque">
    <h2 id="tabla">Comparativa completa</h2>
    <Cifras n={productos.length} min={barato} max={caro} unidad={unidad} dec={dec}
            nivel4={verificados} />
  </div>
  <div class="aparece d3 tabla-categoria">
    <TablaProductos productos={productos.map(paraTabla)} />
  </div>

  <p class="nota">
    <strong>Que estas mirando.</strong> El score es mitad precio por {unidad} frente al mas
    barato de la categoria y mitad calidad: nivel de verificacion, forma quimica del activo y,
    donde la tienda publica las dosis, si la formula llega a la dosis efectiva. Cada producto
    explica su nota linea a linea en su ficha. <a href="/metodologia/#formula">Como se calcula</a>.
  </p>

  <Faq faqs={faqs} titulo={`Preguntas sobre ${cat.termino}`} />

  {/* Las dos colas de enlaces internos median 3.981 px en escritorio y 10.232 en movil,
      o sea el 64 % de la pagina en un movil, para 142 enlaces que nadie recorre de
      arriba abajo. Van dentro de un <details> cerrado, con su recuento en el resumen.
      NO se pierde SEO: esto es Astro estatico, los 142 <a> siguen en el HTML servido y
      Google los rastrea dentro de un details igual que fuera. Lo unico que cambia es
      que no son lo ultimo que ve una persona antes de irse. */}
  {(selecciones.length > 0 || versus.length > 0) && (
    <section class="seccion">
      <details class="cola-enlaces">
        <summary>
          <span class="titulo-cola">Preguntas mas concretas sobre {cat.termino}</span>
          <span class="cuenta-cola">{selecciones.length + versus.length} comparativas
            {' '}&mdash; la misma tabla, filtrada</span>
        </summary>
        <div class="lista-categorias compacta">
          {selecciones.map((l) => (
            <a class="fila-categoria" href={`/mejores/${l.slug}/`}>
              <span class="nombre">{l.h1.split(':')[0]}</span>
              <span class="guia" aria-hidden="true"></span>
              <span class="cuenta">{l.productos.length} prod.</span>
            </a>
          ))}
          {versus.map((l) => (
            <a class="fila-categoria" href={`/comparativa/${l.slug}/`}>
              <span class="nombre">{l.na} o {l.nb} en {cat.termino}</span>
              <span class="guia" aria-hidden="true"></span>
              <span class="cuenta">{l.productos.length} prod.</span>
            </a>
          ))}
        </div>
      </details>
    </section>
  )}

  <section class="seccion">
    <details class="cola-enlaces">
      <summary>
        <span class="titulo-cola">Otras comparativas</span>
        <span class="cuenta-cola">{otras.length} categorias &mdash; mismo metodo</span>
      </summary>
      <div class="lista-categorias compacta">
        {otras.map((c) => (
          <a class="fila-categoria" href={`/${c.slug}/`}>
            <span class="nombre">{c.consultas?.mejor
              ? c.consultas.mejor.charAt(0).toUpperCase() + c.consultas.mejor.slice(1)
              : c.nombre}</span>
            <span class="guia" aria-hidden="true"></span>
            <span class="cuenta">{c.productos} prod.</span>
          </a>
        ))}
      </div>
    </details>
  </section>

  <p class="nota">
    <strong>Los datos, en crudo.</strong> Este ranking tambien esta en
    {' '}<a href={`/datos/${cat.slug}.json`}>JSON</a>, con la fecha de recogida y el enlace a
    cada ficha. Se puede citar y reutilizar diciendo de donde sale y de que dia son los precios.
  </p>
</Base>
