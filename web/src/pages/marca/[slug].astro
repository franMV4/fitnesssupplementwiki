---
import Base from '../../layouts/Base.astro';
import Aviso from '../../componentes/Aviso.astro';
import Faq from '../../componentes/Faq.astro';
import datos from '../../datos/dataset.json';
import { MARCAS } from '../../datos/marcas.js';
import { NIVEL, TIENDAS, UNIDAD, eur, puntos } from '../../datos/util.js';
import { anio, corta, fechaLarga, formatoDe, listaLd, nom, resumen, tiendaDe, titula } from '../../datos/seo.js';
import { abs } from '../../sitio.js';

export function getStaticPaths() {
  return MARCAS.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const canonica = abs(`/marca/${m.slug}`);
const n = m.productos.length;
const nombresTiendas = m.tiendas.map((t) => TIENDAS[t] ?? t);

// Por categoria: la horquilla en su unidad y el mas barato. Es la fila que se copia en
// la respuesta corta y en la descripcion.
const bloques = m.categorias.map((g) => ({ ...g, r: resumen(g.cat, g.productos) }));
const principales = bloques.slice(0, 3).filter((b) => b.r.barato);

const titulo = titula(`${m.nombre} ${anio(datos.generado)}: precios de ${n} productos`,
  ', opinión y comparativa', ' comparados', '');

const descripcion = corta(
  `${m.nombre} en ${nombresTiendas.length} ${nombresTiendas.length === 1 ? 'tienda' : 'tiendas'}: ` +
  principales.map((b) => `${b.cat.nombre.toLowerCase()} desde ${b.r.precio(b.r.barato.precio_referencia)}`)
    .join(', ') +
  `. Precio por kilo, nota y certificación de sus ${n} productos, del ${fechaLarga(datos.generado)}.`, 200);

const respuesta = [
  `Esta web compara ${n} productos de ${m.nombre} en ${m.categorias.length} ` +
  `${m.categorias.length === 1 ? 'categoria' : 'categorias'}, vendidos en ${nombresTiendas.join(', ')}.`,
  m.lider?.score_final != null
    ? `El que mejor puntua es ${nom(m.lider)}, con ${m.lider.score_final.toFixed(0)} sobre 100 ` +
      `a ${eur(m.lider.precio_eur)} en ${tiendaDe(m.lider)}.` : '',
  ...principales.map((b) => `En ${b.cat.nombre.toLowerCase()}, el mas barato por ${b.r.unidad} es ` +
    `${nom(b.r.barato)}, a ${b.r.precio(b.r.barato.precio_referencia)}.`),
  `Precios recogidos el ${fechaLarga(datos.generado)}.`,
].filter(Boolean).join(' ');

const faqs = [
  principales[0] && {
    p: `¿Cual es el producto de ${m.nombre} mas barato?`,
    r: principales.map((b) => `En ${b.cat.nombre.toLowerCase()}, ${nom(b.r.barato)} de ` +
      `${tiendaDe(b.r.barato)}: ${eur(b.r.barato.precio_eur)} el envase de ` +
      `${formatoDe(b.r.barato)}, o ${b.r.precio(b.r.barato.precio_referencia)}.`).join(' ') +
      ' Se compara por precio por unidad de venta, no por envase: un bote grande puede costar ' +
      'mas y salir mas barato.',
  },
  m.lider?.score_final != null && {
    p: `¿Que opinion merece ${m.nombre}?`,
    r: `No hay opiniones pagadas ni estrellas: cada producto lleva una nota de 0 a 100, mitad ` +
       `precio frente al mas barato de su categoria y mitad calidad verificable. El mejor de ` +
       `${m.nombre} es ${nom(m.lider)} con ${m.lider.score_final.toFixed(0)} puntos, y cada ` +
       `ficha explica su nota linea a linea.`,
  },
  {
    p: `¿Donde comprar ${m.nombre} mas barato?`,
    r: nombresTiendas.length === 1
      ? `Entre las tiendas comparadas aqui, solo ${nombresTiendas[0]} vende ${m.nombre}.`
      : `Se vende en ${nombresTiendas.join(', ')}. La tabla de cada categoria ordena los ` +
        `productos por precio por unidad con la tienda al lado, asi que la primera fila es la ` +
        `compra mas barata de ese tipo.`,
  },
].filter(Boolean);

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': canonica,
    url: canonica,
    name: titulo,
    description: descripcion,
    inLanguage: 'es-ES',
    dateModified: datos.generado,
    about: { '@type': 'Brand', name: m.nombre },
    isPartOf: [{ '@id': abs('/#sitio') }, { '@id': abs('/#dataset') }],
    publisher: { '@id': abs('/#editor') },
    mainEntity: listaLd(`Productos de ${m.nombre}`, m.productos),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Marcas', item: abs('/marcas') },
      { '@type': 'ListItem', position: 3, name: m.nombre, item: canonica },
    ],
  },
];
---
<Base ancho="completo" titulo={titulo} descripcion={descripcion} schema={schema}
      noindex={!m.indexable}>

  <p class="migas"><a href="/">Inicio</a> / <a href="/marcas/">Marcas</a> / {m.nombre}</p>

  <section class="cabecera-pagina">
    <p class="antetitulo aparece">
      Marca · datos del <time datetime={datos.generado}>{fechaLarga(datos.generado)}</time>
    </p>
    <h1 class="aparece d1">{m.nombre}: precios y comparativa de sus {n} productos</h1>
    <p class="respuesta aparece d2"><b>La respuesta corta.</b> {respuesta}</p>
  </section>

  <Aviso />

  {bloques.map((b) => {
    const unidad = UNIDAD[b.cat.unidad_precio] ?? 'kg';
    return (
      <section class="seccion" id={b.cat.slug}>
        <div class="cabecera-seccion">
          <h2>{b.cat.nombre} de {m.nombre}</h2>
          <p class="apunte">{b.productos.length} {b.productos.length === 1 ? 'producto' : 'productos'},
            del mas barato por {unidad} al mas caro</p>
        </div>
        <div class="tabla-marco">
          <div class="tabla-scroll">
            <table class="apilable">
              <caption>{b.cat.nombre} de {m.nombre} por precio por {unidad}</caption>
              <thead>
                <tr><th>Producto</th><th>Formato</th><th class="num">Precio</th>
                  <th class="num">€/{unidad}</th><th>Nivel</th><th class="num">Score</th><th>Tienda</th></tr>
              </thead>
              <tbody>
                {b.productos.map((p, i) => (
                  <tr>
                    <td class="principal marca"><a href={`/producto/${p.slug}/`}>{p.nombre}</a></td>
                    <td data-et="Formato">{formatoDe(p)}</td>
                    <td class="num" data-et="Precio">{eur(p.precio_eur)}</td>
                    <td class:list={['num', { barato: i === 0 }]} data-et={`€/${unidad}`}>{b.r.precio(p.precio_referencia)}</td>
                    <td data-et="Nivel">
                      <span class={`nivel ${NIVEL[p.nivel_verificacion].clase}`}>
                        <span class="puntos">{puntos(p.nivel_verificacion).map((on) => <i class={on ? 'on' : ''} />)}</span>
                        {p.nivel_verificacion}
                      </span>
                    </td>
                    <td class="num" data-et="Score">{p.score_final?.toFixed(0) ?? '—'}</td>
                    <td data-et="Tienda">{tiendaDe(p)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="sutil">
          <a href={`/${b.cat.slug}/`}>Comparar con {b.cat.productos} productos de {b.cat.termino} de todas las marcas →</a>
        </p>
      </section>
    );
  })}

  <Faq faqs={faqs} titulo={`Preguntas sobre ${m.nombre}`} />

  <p class="volver"><a class="boton" href="/marcas/">← Todas las marcas</a></p>
</Base>
