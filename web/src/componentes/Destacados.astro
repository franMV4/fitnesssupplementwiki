---
import { NIVEL, TIENDAS, precioReferencia, puntos } from '../datos/util.js';
import { nom, porScore } from '../datos/seo.js';
import { textos } from '../i18n.js';

// Los tres atajos de arriba de la tabla. Quien llega a /proteina-whey desde Google se
// encuentra 120 filas y no sabe por donde empezar: el 80 % de las visitas quiere una de
// estas tres respuestas, y las tres estan a un clic en vez de a un scroll.
//
// No son "recomendaciones": son el primero de tres ordenaciones distintas de la misma
// tabla, y cada uno dice literalmente por que esta ahi. Si un producto gana dos, sale
// una sola vez con las dos razones: repetirlo daria tres ganadores donde hay dos.
const { productos, unidad, lang = 'es' } = Astro.props;
const t = textos(lang);

const conPrecio = productos.filter((p) => p.precio_referencia != null);
const mejor = porScore(conPrecio)[0] ?? null;
const barato = conPrecio.slice().sort((a, b) => a.precio_referencia - b.precio_referencia)[0] ?? null;
// El mejor certificado solo cuenta si hay sello de verdad (nivel 4): en proteinas el
// techo es un analisis de la propia marca, y llamar a eso "mejor certificado" es vender
// como sello lo que es la palabra del fabricante.
const certificado = porScore(conPrecio.filter((p) => p.nivel_verificacion === 4))[0] ?? null;

const candidatos = [
  { clave: 'calidad-precio', rotulo: t('destacado.calidad_precio'), p: mejor,
    razon: mejor ? t('destacado.razon.calidad_precio', mejor.score_final?.toFixed(0), unidad) : '' },
  { clave: 'barato', rotulo: t('destacado.barato', unidad), p: barato,
    razon: barato ? t('destacado.razon.barato', precioReferencia(barato, lang).valor, unidad) : '' },
  { clave: 'certificado', rotulo: t('destacado.certificado'), p: certificado,
    razon: certificado ? t('destacado.razon.certificado') : '' },
].filter((d) => d.p);

// Un producto que gana dos categorias se funde en una sola tarjeta con las dos razones.
const destacados = [];
for (const d of candidatos) {
  const ya = destacados.find((o) => o.p.id === d.p.id);
  if (ya) {
    ya.rotulo = `${ya.rotulo} ${t('destacado.y')} ${d.rotulo.toLowerCase()}`;
    ya.razones.push(d.razon);
  } else {
    destacados.push({ ...d, razones: [d.razon] });
  }
}
---
{destacados.length > 0 && (
  <div class="destacados aparece d2">
    {destacados.map((d) => {
      const n = NIVEL[lang][d.p.nivel_verificacion];
      return (
        <div class="bloque destacado-bloque">
          <span class="rotulo-destacado">{d.rotulo}</span>
          <h3><a href={`/producto/${d.p.slug}/`}>{nom(d.p)}</a></h3>
          <p class="linea-destacado">
            <span class="cifra">{precioReferencia(d.p, lang).valor}<span class="unidad">/{precioReferencia(d.p, lang).unidad}</span></span>
            <span class={`nivel ${n.clase}`}>
              <span class="puntos">{puntos(d.p.nivel_verificacion).map((on) => <i class={on ? 'on' : ''} />)}</span>
              {n.etiqueta}
            </span>
          </p>
          {d.razones.map((r) => <p>{r}</p>)}
          <p class="sutil">
            {t('destacado.en_tienda')} {TIENDAS[d.p.tienda] ?? d.p.tienda} · <a href={`/producto/${d.p.slug}/`}>{t('destacado.ver_desglose')}</a>
          </p>
        </div>
      );
    })}
  </div>
)}
