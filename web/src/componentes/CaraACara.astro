---
// Las dos secciones que contestan "por que una es mas barata": que lleva dentro cada
// bote (ingrediente a ingrediente, con la dosis por servicio) y de donde sale la
// diferencia de precio (formato, pureza, marca propia, aditivos, analitica).
//
// Vive en un componente y no dentro de la pagina porque lo usan las dos rutas que
// comparan tiendas: el versus (/comparativa/a-vs-b) y la landing de una sola tienda
// (/mejores/<cat>-de-<tienda>, que compara esa tienda con el resto del mercado).
//
// Todo el calculo esta en datos/porque.js; aqui solo se pinta lo que venga. Si una
// categoria no tiene el dato, la fila no existe: no hay celdas rellenas con supuestos.
// Los textos, en los tres idiomas, en datos/landings-i18n.js.
import { ingredientesCaraACara, mg, porQuePrecio } from '../datos/porque.js';
import { copia } from '../datos/landings-i18n.js';
import { enIdioma } from '../datos/categorias-i18n.js';
import { ruta } from '../i18n.js';

const { cat: catEs, ladoA, ladoB, lang = 'es' } = Astro.props;
const T = copia(lang);
const cat = enIdioma(catEs, lang);
const { intro, factores } = porQuePrecio(catEs, ladoA, ladoB, lang);
const ingredientes = ingredientesCaraACara(ladoA, ladoB, 8, lang);
const na = ladoA.nombre;
const nb = ladoB.nombre;

// Lo que se pinta en la celda de un ingrediente: la dosis mediana por servicio y, debajo,
// cuantos de esa tienda lo declaran y cuantos llegan a la dosis con evidencia detras.
// "No lo declara" y "no llega" son cosas distintas y se dicen distinto.
const linea = (l) => {
  if (!l.llevan) return null;
  const partes = [T.cc_lo_llevan(l.llevan, l.total)];
  if (l.cumplen != null) partes.push(T.cc_llegan(l.cumplen));
  else if (l.llevan && !l.conDosis) partes.push(T.cc_ninguno);
  return partes.join(' · ');
};
---
{ingredientes.length > 0 && (
  <section class="seccion" id="ingredientes">
    <div class="cabecera-seccion">
      <h2>{T.cc_h2_ing}</h2>
      <p class="apunte">{T.cc_apunte_ing}</p>
    </div>
    <p class="sutil">{T.cc_ing_p}</p>
    <div class="tabla-marco">
      <div class="tabla-scroll">
        <table class="apilable">
          <caption>{T.cc_caption_ing(na, nb, cat)}</caption>
          <thead>
            <tr>
              <th>{T.cc_col_ing}</th>
              <th class="num">{na}</th>
              <th class="num">{nb}</th>
            </tr>
          </thead>
          <tbody>
            {ingredientes.map((f) => (
              <tr>
                <td class="principal marca">
                  {f.nombre}
                  {f.min != null && <span class="explica">{T.cc_desde(mg(f.min, lang))}</span>}
                </td>
                {[f.a, f.b].map((l, i) => (
                  <td class="num" data-et={i === 0 ? na : nb}>
                    {l.llevan ? (
                      <>
                        <span class={l.dosis != null && f.min != null && l.dosis >= f.min ? 'destacado' : ''}>
                          {mg(l.dosis, lang)}
                        </span>
                        <span class="explica">{linea(l)}</span>
                      </>
                    ) : <span class="sutil">{T.cc_no_lleva}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="nota"><strong>{T.cc_nota_ing_t}</strong>{T.cc_nota_ing}</p>
  </section>
)}

{factores.length > 0 && (
  <section class="seccion" id="por-que">
    <div class="cabecera-seccion">
      <h2>{T.cc_h2_pq}</h2>
      <p class="apunte">{T.cc_apunte_pq}</p>
    </div>
    {intro && <p class="entradilla">{intro}</p>}
    <div class="tabla-marco">
      <div class="tabla-scroll">
        <table class="apilable">
          <caption>{T.cc_caption_pq(na, nb, cat)}</caption>
          <thead>
            <tr>
              <th>{T.cc_col_factor}</th>
              <th class="num">{na}</th>
              <th class="num">{nb}</th>
            </tr>
          </thead>
          <tbody>
            {factores.map((f) => (
              <tr>
                <td class="principal marca">
                  {f.titulo}
                  <span class="explica">{f.texto}</span>
                </td>
                <td class="num" data-et={na}>{f.a}</td>
                <td class="num" data-et={nb}>{f.b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="nota">
      <strong>{T.cc_nota_pq_t}</strong>{T.cc_nota_pq}<a href={ruta(lang, '/metodologia/')}>{T.cc_como}</a>.
    </p>
  </section>
)}
