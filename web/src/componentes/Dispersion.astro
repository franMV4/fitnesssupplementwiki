---
// Precio frente a calidad de una categoria entera, en un SVG dibujado en el build.
//
// Es la metodologia en una imagen: si los puntos suben en diagonal, en esta categoria lo
// caro es mejor; si estan repartidos, pagar mas no compra nada. Eso no lo dice ningun
// parrafo tan rapido, y se lee antes de leer la tabla.
//
// Sin libreria de graficos y sin JS: son cuadrados y dos ejes. Escala logaritmica en el
// precio por la misma razon que en la portada: en creatina el techo es veinte veces el
// suelo, y en lineal los 156 productos se apelotonan en el primer 5 % de la regla.
import { eur } from '../datos/util.js';

const { productos, unidad, lider } = Astro.props;
const puntos = productos.filter((p) => p.precio_referencia > 0 && p.score_calidad != null);
const precios = puntos.map((p) => p.precio_referencia);
const min = Math.min(...precios), max = Math.max(...precios);
// Con menos de ocho productos, o con todos al mismo precio, la nube no dice nada y solo
// ocupa pantalla: la pagina no la pinta.
const hay = puntos.length >= 8 && max > min;

const AN = 640, AL = 260, IZQ = 34, ABA = 26, ARR = 10, DER = 10;
const ex = (v) => IZQ + ((Math.log(v) - Math.log(min)) / (Math.log(max) - Math.log(min)))
                        * (AN - IZQ - DER);
const ey = (v) => ARR + (1 - Math.min(100, Math.max(0, v)) / 100) * (AL - ARR - ABA);
const dec = unidad === 'kg' ? 2 : 3;
// Tres marcas en el eje de precio: el suelo, la media geometrica (que en escala
// logaritmica cae justo en el centro) y el techo.
const medio = Math.exp((Math.log(min) + Math.log(max)) / 2);
---
{hay && (
  <figure class="dispersion">
    <svg viewBox={`0 0 ${AN} ${AL}`} role="img"
         aria-label={`Nube de ${puntos.length} productos: precio por ${unidad} de ${eur(min, dec)} a ${eur(max, dec)} frente a nota de calidad de 0 a 100`}>
      {[0, 50, 100].map((v) => (
        <>
          <line class="reja" x1={IZQ} x2={AN - DER} y1={ey(v)} y2={ey(v)} />
          <text class="rotulo" x={IZQ - 6} y={ey(v) + 4} text-anchor="end">{v}</text>
        </>
      ))}
      {[min, medio, max].map((v, i) => (
        <text class="rotulo" x={ex(v)} y={AL - 8}
              text-anchor={i === 0 ? 'start' : i === 2 ? 'end' : 'middle'}>{eur(v, dec)}</text>
      ))}
      {puntos.map((p) => (
        <rect class={`punto ${lider && p.slug === lider.slug ? 'lider' : ''}`}
              x={ex(p.precio_referencia) - 3} y={ey(p.score_calidad) - 3} width="6" height="6">
          <title>{p.marca !== 'Desconocida' ? p.marca + ' ' : ''}{p.nombre}: {eur(p.precio_referencia, dec)}/{unidad}, calidad {Math.round(p.score_calidad)}</title>
        </rect>
      ))}
    </svg>
    <figcaption>
      Cada cuadrado es un producto: a la derecha, mas caro por {unidad}; arriba, mejor
      nota de calidad (certificacion, forma quimica y dosis). El cuadrado marcado es el
      primero de la tabla. Lo de <b>arriba a la izquierda</b> es lo que busca esta web:
      buena nota por poco dinero.
    </figcaption>
  </figure>
)}
