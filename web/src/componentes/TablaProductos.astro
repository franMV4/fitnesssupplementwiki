---
import { NIVEL, ORDENES, TIENDAS, UNIDAD, eur, nombreOrden, precioReferencia, puntos,
         tieneSello } from '../datos/util.js';
import { ruta, textos } from '../i18n.js';
import { metodo } from '../datos/metodologia.js';

// La tabla de categoria: se pinta entera en el build y los filtros los mueve un script
// de ~120 lineas sobre las filas que ya estan en el DOM (tabla.js).
//
// Antes era la unica isla React del sitio, y salia carisima: las mismas 120 filas
// viajaban DOS veces, una en el HTML ya pintado (que es lo que leen el lector, Google y
// los modelos) y otra en el atributo `props` del <astro-island> para poder hidratarlas
// (218 KB del HTML de /proteina-whey), mas 184 KB de runtime de React para ordenar una
// tabla. El navegador parseaba el catalogo dos veces antes de que se pudiera tocar nada.
//
// Lo que hace el script no es distinto de lo que hacia el componente: llama al MISMO
// `filtrar()` de datos/util.js, con los mismos ordenes y los mismos tests
// (`node tabla.test.mjs`). Solo cambia de donde saca los productos: de los `data-` de
// cada <tr> en vez de un JSON duplicado.
//
// Sin JavaScript la tabla sigue siendo la de siempre: ordenada por score, con sus
// puestos, su fila mas barata marcada y las 25 primeras a la vista.
const { productos, lang = 'es' } = Astro.props;
const t = textos(lang);
const m = metodo(lang);
// Los dos sellos de la web los escribe el pipeline en espanol dentro de cada producto
// ("Mejor precio", "Verificado nivel 4"). Aqui se reconocen por su forma y se reescriben
// con los textos de la metodologia, que es donde viven los mismos dos sellos traducidos:
// un sello no puede decir una cosa en la tabla y otra en la pagina que lo explica.
const sello = (s) => {
  if (lang === 'es') return s;
  const nivel = /^Verificado nivel (\d)/.exec(s.texto);
  if (nivel) return { texto: m('sello_verificado', nivel[1]), criterio: m('sello_verificado_criterio') };
  const umbral = /(\d+) sobre 100/.exec(s.criterio ?? '');
  if (s.texto === 'Mejor precio') {
    return { texto: m('sello_precio'), criterio: umbral ? m('sello_precio_criterio', umbral[1]) : '' };
  }
  return s;
};

const TOPE = 25;

const NIVELES_CHIP = [
  { v: 1, texto: t('tabla.nivel.todos') },
  { v: 2, texto: t('tabla.nivel.2') },
  { v: 3, texto: t('tabla.nivel.3') },
  { v: 4, texto: t('tabla.nivel.4') },
];

// Sellos que existen en el dataset y que valen nivel 4 porque los respalda un tercero.
// El chip solo aparece si esta tabla tiene alguno: un filtro que siempre deja la tabla
// vacia es peor que no tener filtro.
const SELLOS_CHIP = [
  { tipo: 'creapure', texto: t('tabla.solo_sello', 'Creapure') },
  { tipo: 'ifos', texto: t('tabla.solo_sello', 'IFOS') },
];

const tiendas = [...new Set(productos.map((p) => p.tienda))].sort();

// Sellos de calidad de verdad (Creapure, IFOS) son nivel 4 y solo existen en unas pocas
// categorias (creatina, omega 3). En proteinas o preentrenos, como mucho hay "analisis de
// marca" (nivel 3), que no es un sello: la columna de verificacion es ruido y la ocultamos
// entera (con su filtro) cuando ningun producto de la tabla llega al nivel de sello.
const hayVerificacion = productos.some((p) => p.nivel_verificacion >= 4);

// Una categoria en capsulas (omega 3, multivitaminicos) no tiene precio por kilo, y
// poner "€/kg" encima de un precio por capsula es ensenar un numero mintiendo sobre
// que numero es.
const unidadPrecio = `€/${UNIDAD[lang][productos.find((p) => p.unidad_precio)?.unidad_precio] ?? 'kg'}`;

// Los sellos presentes en ESTA tabla. En proteinas no hay ninguno y los chips no salen.
const sellosVisibles = SELLOS_CHIP.filter((s) => productos.some((p) => tieneSello(p, s.tipo)));

// El estado inicial es el de siempre: sin filtros y por score. Lo mismo que servia React
// en el HTML, asi que el bot lee exactamente lo mismo que antes.
const visibles = productos.slice().sort(ORDENES.score.cmp);
const refs = visibles.map((p) => p.precio_referencia).filter((n) => n != null);
const minPrecio = refs.length ? Math.min(...refs) : null;

// Lo que el script necesita de cada fila para volver a filtrar y ordenar. Son ocho
// campos cortos por producto, no el producto entero: unos 60 bytes frente a los 900 que
// costaba serializar el mismo producto en las props de la isla.
// tabla.js es un modulo suelto (no una isla) y no recibe props: los pocos textos que
// escribe en caliente (el pie, el estado de los botones, la barra de comparar) viajan
// aqui dentro y los lee una vez al montar. Un JSON de 400 bytes en vez de tres copias
// del script o de meter el diccionario entero en el bundle del navegador.
const textoScript = JSON.stringify({
  pie: t('tabla.pie'),
  pieFiltrado: t('tabla.pie_filtrado', '%v', '%n'),
  comparar: t('tabla.comparar'),
  enComparativa: t('tabla.en_comparativa'),
  miLista: t('tabla.mi_lista'),
  enMiLista: t('tabla.en_mi_lista'),
  guardado: t('tabla.guardados', 1),
  guardados: t('tabla.guardados', 2),
  tope: t('tabla.tope', '%s'),
  opinion: t('tabla.opiniones_lectores', 1),
  opiniones: t('tabla.opiniones_lectores', 2),
  aqui: t('tabla.aqui'),
  caption: t('tabla.caption', '%s'),
  ordenes: Object.fromEntries(Object.keys(ORDENES).map((k) => [k, nombreOrden(k, lang)])),
});

const fila = (p) => ({
  'data-slug': p.slug,
  'data-cat': p.categoria,
  'data-busca': `${p.marca} ${p.nombre}`.toLowerCase(),
  'data-tienda': p.tienda,
  'data-nivel': p.nivel_verificacion,
  'data-sellos': (p.certificaciones ?? []).map((c) => c.tipo).join(' '),
  'data-ref': p.precio_referencia ?? '',
  'data-precio': p.precio_eur ?? '',
  'data-score': p.score_final ?? '',
});
---
<div class="tabla-comparador" data-tope={TOPE} data-unidad={unidadPrecio}
     data-total={productos.length} data-txt={textoScript}>

  {/* El rotulo de cada filtro ya no va ENCIMA del control, va DENTRO: en el hueco del
      campo vacio, o como primera opcion del desplegable. Cuatro rotulos apilados
      costaban 318 px de mandos en escritorio y 448 en movil por encima de la primera
      fila de datos, que es a lo que se viene. El texto no se pierde: sigue en el
      <label>, que es de donde lo lee un lector de pantalla. */}
  {/* En movil los filtros van plegados tras un boton (PLAN-ESTETICA F3): apilados
      empujaban la primera fila fuera de la pantalla. Va `open` en el HTML para que sin
      JS (y en escritorio) se vean; tabla.js lo cierra al cargar solo si la pantalla es
      de movil. El resumen solo se pinta en movil (seccion 19). */}
  <details class="filtros" open>
    <summary>{t('tabla.filtrar')}</summary>
  <div class="barra-filtros">
    <label class="campo ancho">
      <span class="solo-lector">{t('tabla.buscar')}</span>
      <input type="search" name="busqueda" placeholder={t('tabla.buscar_hueco')} />
    </label>
    <label class="campo">
      <span class="solo-lector">{t('tabla.tienda')}</span>
      <select name="tienda">
        <option value="">{t('tabla.todas_tiendas')}</option>
        {tiendas.map((t) => <option value={t}>{TIENDAS[t] ?? t}</option>)}
      </select>
    </label>
    <label class="campo">
      <span class="solo-lector">{t('tabla.maximo', unidadPrecio)}</span>
      <input type="number" name="precioMax" min="0" step="1" placeholder={t('tabla.maximo', unidadPrecio)} />
    </label>
    {/* Este es el unico que no puede llevar el rotulo dentro: un desplegable ensena
        siempre lo elegido, y "Score (recomendado)" a secas no dice que sea el orden.
        Lleva el glifo de ordenar delante, que ocupa una letra en vez de una linea. */}
    <label class="campo campo-orden">
      <span class="solo-lector">{t('tabla.ordenar_por')}</span>
      <select name="orden">
        {/* Los que no dependen de nada dinamico. El de la nota de los lectores lo anade
            tabla.js si la API dice que en esta categoria hay resenas. */}
        {Object.entries(ORDENES).filter(([, v]) => !v.tarde)
          .map(([k]) => <option value={k}>{nombreOrden(k, lang)}</option>)}
      </select>
    </label>
    {/* El chip de limpiar solo tiene sentido con algun filtro puesto: al cargar no hay
        ninguno, asi que sale oculto y lo ensena el script. */}
    <div class="campo linea" data-limpiar hidden>
      <div class="grupo-chips">
        <button type="button" class="chip">{t('tabla.limpiar')}</button>
      </div>
    </div>
    {hayVerificacion && (
      <div class="campo linea">
        {/* El rotulo baja a un renglon de mando en mono, del mismo tono que las reglas:
            no es un titulo de campo, es lo que hay escrito al lado de una fila de
            botones. */}
        <span class="rotulo-mando">{t('tabla.verificacion_minima')}</span>
        <div class="grupo-chips">
          {NIVELES_CHIP.map((n) => (
            <button type="button" class="chip" data-nivel={n.v}
                    aria-pressed={n.v === 1 ? 'true' : 'false'}>{n.texto}</button>
          ))}
          {sellosVisibles.map((s) => (
            <button type="button" class="chip" data-sello={s.tipo}
                    aria-pressed="false">{s.texto}</button>
          ))}
        </div>
      </div>
    )}
  </div>
  </details>

  <div class="tabla-marco">
    <div class="tabla-scroll">
      <table class:list={['apilable', 'fichas', { recortada: visibles.length > TOPE }]}>
        <caption>{t('tabla.caption', nombreOrden('score', lang).toLowerCase())}</caption>
        <thead>
          <tr>
            <th class="rango">#</th>
            <th>{t('tabla.col.producto')}</th>
            <th>{t('tabla.tienda')}</th>
            {/* Cabecera que ordena al pincharla. El desplegable "Ordenar por" sigue
                estando (es el unico que se ve en movil, donde la tabla se apila y no hay
                cabecera): los dos escriben el mismo estado y no pueden contradecirse. */}
            <th class="num" aria-sort="none"><button type="button" class="orden" data-orden="precio">{t('tabla.col.envase')}</button></th>
            <th class="num" aria-sort="none"><button type="button" class="orden" data-orden="kg">{unidadPrecio}</button></th>
            {hayVerificacion && <th>{t('tabla.col.verificacion')}</th>}
            <th class="num" aria-sort="ascending"><button type="button" class="orden activo" data-orden="score">{t('tabla.col.score')}</button></th>
          </tr>
        </thead>
        <tbody>
          {visibles.map((p, i) => (
            <tr {...fila(p)}>
              <td class:list={['puesto', { top: i === 0 }]}>{String(i + 1).padStart(2, '0')}</td>
              <td class:list={['principal', { alarma: p.flag_infradosaje }]}>
                {/* Sabores, sellos y avisos van dentro de la columna del nombre: fuera
                    del flex empezaban linea nueva y caian debajo de la foto. */}
                <div class="con-miniatura">
                  {/* La foto la sirve la CDN de la tienda; aqui no se aloja ninguna.
                      loading/decoding perezosos: son 45 imagenes en una sola tabla.
                      onerror inline: el catalogo de una tienda se pudre solo (Zumub
                      publica en su JSON-LD ficheros que ya ha borrado). Un hueco es
                      mejor que el icono de rota, y esto lo cubre sin comprobar 3.000
                      URLs en cada pasada del scraper. */}
                  {p.imagen && (
                    <img class="miniatura" src={p.imagen} alt="" aria-hidden="true"
                         referrerpolicy="no-referrer" onerror="this.style.visibility='hidden'"
                         loading="lazy" decoding="async" width="55" height="55" />
                  )}
                  <div class="celda-producto">
                    <a href={`/producto/${p.slug}/`}>
                      {/* En Amazon la marca no viene en ningun campo y el scraper la deja
                          en "Desconocida": es lo honesto en la BD, pero pintarla delante
                          de cada nombre llena la columna de una palabra que no es un
                          dato. Sin marca, manda el nombre. */}
                      <span class="enlace-producto">
                        {p.marca !== 'Desconocida' && <span class="marca">{p.marca}</span>}
                        {p.marca !== 'Desconocida' ? ' ' : ''}{p.nombre}
                      </span>
                    </a>
                    {p.sabores > 1 && <span class="sutil"> · {t('tabla.sabores', p.sabores)}</span>}
                    {/* La nota de los compradores en la tienda y lo que la tabla
                        nutricional dice que es activo. Van en la celda del nombre y no en
                        columnas propias: dos columnas mas estrechan la tabla en movil por
                        dos datos que no todas las tiendas publican. */}
                    {p.valoracion && (
                      <span class="opinion" title={t('tabla.opiniones_tienda', p.n_valoraciones)}>
                        {p.valoracion.toFixed(1)}<i aria-hidden="true">★</i>
                        <span class="sutil"> ({p.n_valoraciones})</span>
                      </span>
                    )}
                    {p.pureza_real && (
                      <span class="sutil" title={t('tabla.activo_titulo')}>
                        {' · '}{t('tabla.activo', Math.round(p.pureza_real * 100))}
                      </span>
                    )}
                    {p.requisitos_total > 0 && (
                      <span class:list={['requisitos-mini',
                                         { incumple: p.requisitos_cumple < p.requisitos_total }]}
                            title={t('tabla.requisitos_titulo')}>
                        {' · '}{t('tabla.requisitos', p.requisitos_cumple, p.requisitos_total)}
                      </span>
                    )}
                    {p.sellos?.map(sello).map((s) => <span class="sello" title={s.criterio}>{s.texto}</span>)}
                    {p.flag_infradosaje && <div class="infradosis">{t('tabla.infradosis')}</div>}
                    {/* Guardar para comparar. Va dentro de la celda del nombre y no en
                        una columna nueva: una columna mas estrecha la tabla en movil por
                        una funcion que no usa todo el mundo. */}
                    <button type="button" class="marcar" aria-pressed="false">{t('tabla.comparar')}</button>
                    {/* Comparar es para esta tarde: cuatro botes enfrentados y a decidir.
                        Mi lista es para el mes que viene: lo que tomas, con tu dosis y lo
                        que te cuesta. Son dos cosas distintas y por eso son dos botones. */}
                    <button type="button" class="marcar mi-lista" aria-pressed="false">{t('tabla.mi_lista')}</button>
                  </div>
                </div>
              </td>
              <td data-et="Tienda">
                <a href={p.url_afiliado ?? p.url}
                   rel={p.url_afiliado ? 'sponsored nofollow noopener' : 'nofollow noopener'}
                   data-salida={p.tienda} data-afiliado={p.url_afiliado ? '1' : null}
                   target="_blank">{TIENDAS[p.tienda] ?? p.tienda}</a>
              </td>
              <td class="num" data-et={t('tabla.col.envase')}>{eur(p.precio_eur, 2, lang)}</td>
              <td class:list={['num', 'referencia',
                               { destacado: p.precio_referencia != null
                                            && p.precio_referencia === minPrecio }]}
                  data-et={unidadPrecio}>
                {precioReferencia(p, lang).valor}
                {precioReferencia(p, lang).unidad && <span class="sutil"> /{precioReferencia(p, lang).unidad}</span>}
              </td>
              {hayVerificacion && (
                <td data-et={t('tabla.col.verificacion')}>
                  <span class:list={['nivel', NIVEL[lang][p.nivel_verificacion].clase]}>
                    <span class="puntos">{puntos(p.nivel_verificacion).map((on) => <i class:list={[{ on }]} />)}</span>
                    {' '}{NIVEL[lang][p.nivel_verificacion].etiqueta}
                  </span>
                </td>
              )}
              <td class="num puntuacion" data-et={t('tabla.col.score')}>
                <span class="cifra">{p.score_final?.toFixed(0) ?? '—'}</span>
                <span class="barra mini"><span style={`width: ${p.score_final ?? 0}%`} /></span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <button type="button" class="boton ver-mas" hidden={visibles.length <= TOPE}>
      {t('tabla.ver_mas')} <span data-restantes>{visibles.length - TOPE}</span> {t('tabla.ver_mas_cola')}
      <span class="flecha">↓</span>
    </button>
    <a class="volver-arriba" href="#contenido" hidden>↑ {t('tabla.volver_arriba')}</a>
    {/* Era una linea de mono en gris que decia "Ningun producto cumple esos filtros" y
        dejaba al lector en un callejon: la tabla vacia, los filtros arriba fuera de la
        pantalla y ningun sitio donde pulsar. Ahora dice de cuantos habla y trae la
        salida puesta. El boton lleva `data-limpiar` como el chip de arriba: los dos los
        atiende el mismo `closest('[data-limpiar]')` de tabla.js. */}
    <div class="vacio" hidden>
      <p class="vacio-titulo">{t('tabla.vacio_titulo')}</p>
      <p class="vacio-pie">{t('tabla.vacio_pie', productos.length)}</p>
      <div data-limpiar>
        <button type="button" class="chip">{t('tabla.quitar_filtros')}</button>
      </div>
    </div>
  </div>

  {/* El recuento va DEBAJO, como el pie de una tabla impresa: arriba repetia la cifra
      que ya da el bloque de cifras de la cabecera, y decia dos veces lo mismo con dos
      tipografias distintas. Aqui cierra lo que se acaba de leer. */}
  <p class="pie-tabla" aria-live="polite"><b>{productos.length}</b> {t('tabla.pie')}</p>

  <div class="barra-comparar" hidden>
    <span><b data-cuenta>0</b> <span data-etiqueta>{t('tabla.guardados', 0)}</span></span>
    <a class="boton primario" href={ruta(lang, '/comparar/')}>{t('tabla.ver_comparativa')} →</a>
  </div>
</div>

<script>
  import { montarTabla } from './tabla.js';
  document.querySelectorAll('.tabla-comparador').forEach(montarTabla);
</script>
