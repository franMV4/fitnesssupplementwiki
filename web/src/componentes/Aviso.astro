---
import datos from '../datos/dataset.json';
import { ruta, textos } from '../i18n.js';

const { lang = 'es' } = Astro.props;
const t = textos(lang);

// Disclosure de afiliacion. Va donde hay enlaces a tienda, a la vista, no en el pie.
// Solo se ensena si de verdad hay algun enlace de afiliado en el dataset: mientras no
// haya ningun programa dado de alta, este aviso advertiria de una comision que no
// existe, y una web que avisa de lo que no pasa no parece mas transparente, parece que
// no sabe lo que hace. Se enciende solo al rellenar data/afiliados.json y reexportar.
//
// Va plegado (PLAN-ESTETICA F3.1): el aviso completo eran seis renglones encima de la
// tabla en movil, que es a lo que se viene. La linea del resumen ya avisa de lo esencial
// y cumple la obligacion legal; el detalle lo despliega quien quiera. Es un <details>, sin
// JS, y el texto entero sigue en el HTML para Google.
---
{datos.hay_afiliados && (
  <details class="aviso-afiliado">
    <summary><strong>†</strong> {t('aviso.resumen')}</summary>
    <p class="nota">
      {t('aviso.detalle')}<a href={ruta(lang, '/metodologia/#afiliacion')}>{t('aviso.enlace')}</a>.
    </p>
  </details>
)}
